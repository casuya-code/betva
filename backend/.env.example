PORT=8080
ENV=development
DATABASE_URL=postgres://betva:betva@localhost:5432/betva?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-use-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Admin 2FA: generate with `go run ./cmd/totp`. When ADMIN_TOTP_SECRET is set,
# admin login additionally requires a current six-digit code or the recovery
# code. Leave both empty to disable 2FA (not recommended for production).
ADMIN_TOTP_SECRET=
ADMIN_RECOVERY_CODE=
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Betting rules
STAKE_TIERS_CENTS=50000,100000,200000,500000
PAYOUT_MULTIPLIER_BP=15000
MAX_BET_PER_DAY_CENTS=0

# Community media (images <= 400 KB, short video <= 3 MB)
MEDIA_DIR=media
MAX_IMAGE_BYTES=400000
MAX_VIDEO_BYTES=3000000

# Web Push (VAPID). Generate with: go run ./cmd/vapid
# Leave empty to disable push; the in-app inbox still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUSH_DAILY_CAP=2
QUIET_START_HOUR=22
QUIET_END_HOUR=7

# AI results assistant (Groq, inference-only). Leave empty to disable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Access-fee planner (admin Analytics page). When daily active users reach
# ACCESS_FEE_DAU_TARGET, the suggested monthly contribution per user is
# MONTHLY_OPERATING_COST_CENTS / users, rounded up to whole 500 TZS steps.
# These two are admin-only and are never shown to users.
ACCESS_FEE_DAU_TARGET=0
MONTHLY_OPERATING_COST_CENTS=0

# The flat monthly rate users actually pay for access (cents). This IS shown
# to users on the Profile page via the public config endpoint.
ACCESS_FEE_CENTS=0

# The single official mobile-money number users pay before the admin activates
# their account. Shown on Profile and referenced by /terms. Empty = "Ask the admin".
PAYMENT_NUMBER=

# Off-site backup job (cmd/backup, run as the Railway cron service "backup").
# The API never needs these values. Use an S3-compatible bucket (Railway
# bucket, Cloudflare R2, or AWS S3).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_PREFIX=db
BACKUP_DAILY_KEEP_DAYS=14
BACKUP_WEEKLY_KEEP_DAYS=56
BACKUP_MONTHLY_KEEP_DAYS=183
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read from the environment.
# PG_DUMP / PG_RESTORE default to the binaries on PATH (postgres:18 image).

# Optional second provider (Cloudflare R2) mirror. All four values must be set
# together. Create the bucket with: go run ./cmd/r2bucket
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
BACKUP_R2_REGION=auto
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY are read from the environment.
# Use `backup -secondary -list` to inspect the mirror.
