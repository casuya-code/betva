PORT=8080
ENV=development
DATABASE_URL=postgres://betva:betva@localhost:5432/betva?sslmode=disable
# Max pgx pool connections (default 20). Connections are recycled after 30m.
DB_MAX_CONNS=20
# Optional: backs the /stats cache and shared rate limits. The API starts
# without Redis and falls back to in-memory caches and counters.
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-use-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Admin 2FA: generate with `go run ./cmd/totp`. When ADMIN_TOTP_SECRET is set,
# admin login additionally requires a current six-digit code or the recovery
# code. Leave both empty to disable 2FA (not recommended for production).
ADMIN_TOTP_SECRET=
ADMIN_RECOVERY_CODE=
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Betting rules
STAKE_TIERS_CENTS=50000,100000,200000,500000
PAYOUT_MULTIPLIER_BP=15000
MAX_BET_PER_DAY_CENTS=0

# Automatic match settlement. Enabled by default. Ended matches with no result
# stay 'awaiting_result' until a score is stored by an admin or taken from an
# approved suggestion (web feed or AI); only settlement sets status='finished'.
# AUTO_SETTLE_ENABLED=0 disables the whole job.
AUTO_SETTLE_ENABLED=1
AUTO_SETTLE_GRACE_MINUTES=120
AUTO_SETTLE_INTERVAL_MINUTES=15

# Deterministic web result discovery (separate from Groq). ESPN's public
# scoreboard JSON supplies FT and HT scores; 100Tip graded rows cross-check
# them. A found score is written as an approved result suggestion and is then
# settled by the sweep above. A disagreement is left for an admin.
# AUTO_RESULT_FETCH_ENABLED=0 stops web discovery (manual/AI settle still work).
AUTO_RESULT_FETCH_ENABLED=1
AUTO_RESULT_FETCH_MAX_DATES=7

# Community media (images <= 400 KB, short video <= 3 MB)
MEDIA_DIR=media
MAX_IMAGE_BYTES=400000
MAX_VIDEO_BYTES=3000000

# Web Push (VAPID). Generate with: go run ./cmd/vapid
# Leave empty to disable push; the in-app inbox still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUSH_DAILY_CAP=2
QUIET_START_HOUR=22
QUIET_END_HOUR=7

# AI results assistant (Groq, inference-only). Leave empty to disable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Access-fee planner (admin Analytics page). When daily active users reach
# ACCESS_FEE_DAU_TARGET, the suggested monthly contribution per user is
# MONTHLY_OPERATING_COST_CENTS / users, rounded up to whole 500 TZS steps.
# These two are admin-only and are never shown to users.
ACCESS_FEE_DAU_TARGET=0
MONTHLY_OPERATING_COST_CENTS=0

# The flat monthly rate users actually pay for access (cents). This IS shown
# to users on the Profile page via the public config endpoint.
ACCESS_FEE_CENTS=0

# The single official mobile-money number users pay before the admin activates
# their account. PAYMENT_NAME is the account holder shown next to it.
# Shown on Profile and referenced by /terms. Empty = "Ask the admin".
PAYMENT_NUMBER=
PAYMENT_NAME=

# Off-site backup job (cmd/backup, run as the Railway cron service "backup").
# The API never needs these values. Use an S3-compatible bucket (Railway
# bucket, Cloudflare R2, or AWS S3).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_PREFIX=db
BACKUP_DAILY_KEEP_DAYS=14
BACKUP_WEEKLY_KEEP_DAYS=56
BACKUP_MONTHLY_KEEP_DAYS=183
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read from the environment.
# PG_DUMP / PG_RESTORE default to the binaries on PATH (postgres:18 image).

# Optional second provider (Cloudflare R2) mirror. All four values must be set
# together. Create the bucket with: go run ./cmd/r2bucket
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
BACKUP_R2_REGION=auto
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY are read from the environment.
# Use `backup -secondary -list` to inspect the mirror.

# Community media storage (Cloudflare R2). When R2 is enabled, uploads go to
# R2 and playback can be served directly from R2/Cloudflare (no Railway bytes).
# Create an R2 bucket and an S3 API token with Object Read & Write.
#
# Public delivery (recommended for public community media, zero backend playback
# cost): enable public bucket access and set R2_MEDIA_PUBLIC_URL to the bucket's
# r2.dev public URL, or to a custom domain attached to the bucket in Cloudflare
# for edge/CDN control. A custom domain is optional.
#   R2_ACCOUNT_ID / R2_MEDIA_BUCKET / R2_MEDIA_PUBLIC_URL / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY
#
# Presigned/private delivery (minimal backend cost: API signs, browser streams
# directly from R2): set R2_MEDIA_PRESIGN_TTL_SECONDS > 0. R2_MEDIA_PUBLIC_URL
# may be left empty for a private bucket. Stored media references are signed on
# read and expire after the TTL.
R2_ACCOUNT_ID=
R2_MEDIA_BUCKET=
R2_MEDIA_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_PRESIGN_TTL_SECONDS=0
