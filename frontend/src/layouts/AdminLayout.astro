---
import '../styles/global.css';
import BrandName from '../components/BrandName.astro';

interface Props {
  title?: string;
  active?: string;
}
const { title = 'Betva Admin', active = '' } = Astro.props;
const API = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
const links = [
  { href: '/admin', label: 'Overview', key: 'overview' },
  { href: '/admin/matches', label: 'Matches', key: 'matches' },
  { href: '/admin/users', label: 'Users', key: 'users' },
  { href: '/admin/analytics', label: 'Analytics', key: 'analytics' },
  { href: '/admin/ai', label: 'AI Results', key: 'ai' },
  { href: '/admin/community', label: 'Community', key: 'community' },
  { href: '/admin/notifications', label: 'Notifications', key: 'notifications' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Betva administration: matches, users, community moderation, and notifications." />
    <meta name="theme-color" content="#f6f5f2" />
    <script is:inline>(function(){var t='light';try{var s=localStorage.getItem('betva_theme');if(s==='dark'||s==='light')t=s;else if(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)t='dark';}catch(e){}document.documentElement.setAttribute('data-theme',t);var m=document.querySelector('meta[name="theme-color"]');if(m)m.setAttribute('content',t==='dark'?'#141719':'#f6f5f2');})();</script>
    <meta name="betva-api" content={API} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="preconnect" href={API} crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <!-- No render-blocking preloader here: the console is a trusted, fast
         shell and its data streams into skeleton placeholders instead. -->
    <header class="admin-header">
      <div class="admin-header-inner">
        <a href="/admin" class="admin-brand">
          <img src="/favicon.svg" alt="" class="admin-logo" width="30" height="30" decoding="async" fetchpriority="low" />
          <span><BrandName /> <span class="admin-tag">Admin</span></span>
        </a>
        <nav class="admin-nav">
          {links.map((l) => (
            <a href={l.href} class={`admin-nav-link ${active === l.key ? 'active' : ''}`}>{l.label}</a>
          ))}
          <button id="adminLogout" class="admin-nav-link admin-logout" type="button">Logout</button>
        </nav>
      </div>
    </header>

    <main class="admin-main">
      <slot />
    </main>

    <script>
      document.getElementById('adminLogout')?.addEventListener('click', () => {
        localStorage.removeItem('betva_admin_token');
        window.location.href = '/admin/login';
      });
    </script>
  </body>
</html>

<style>
  .admin-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--nav-bg);
    border-bottom: 1px solid var(--border);
  }
  .admin-header-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--s2) var(--s4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2) var(--s3);
    flex-wrap: wrap;
  }
  @media (max-width: 899px) {
    .admin-header-inner { align-items: flex-start; }
    .admin-nav { width: 100%; }
  }
  @media (min-width: 640px) {
    .admin-header-inner { padding-inline: var(--s6); }
  }
  @media (min-width: 1024px) {
    .admin-header-inner { padding-inline: var(--s8); }
  }
  .admin-brand {
    display: flex;
    align-items: center;
    gap: var(--s2);
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--t-md);
    min-height: var(--tap);
  }
  .admin-logo {
    width: 30px;
    height: 30px;
    border-radius: var(--r-sm);
    display: block;
    flex: none;
  }
  .admin-tag {
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .admin-nav {
    display: flex;
    align-items: center;
    gap: var(--s1);
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    max-width: 100%;
    padding-bottom: 2px;
  }
  .admin-nav::-webkit-scrollbar { display: none; }
  @media (min-width: 900px) {
    .admin-nav {
      flex-wrap: wrap;
      overflow-x: visible;
      justify-content: flex-end;
    }
  }
  .admin-nav-link {
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
    padding: var(--s2) var(--s4);
    border-radius: var(--r-md);
    color: var(--text-2);
    text-decoration: none;
    font-size: var(--t-sm);
    font-weight: 600;
    background: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .admin-nav-link:hover { color: var(--text); background: var(--hover-tint); }
  .admin-nav-link.active { color: var(--brand); background: var(--brand-tint); font-weight: 700; }
  .admin-logout { color: var(--danger); }
  .admin-main {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--s5) var(--s4) var(--s8);
  }
  @media (min-width: 640px) {
    .admin-main { padding-inline: var(--s6); }
  }
  @media (min-width: 1024px) {
    .admin-main { padding-inline: var(--s8); }
  }
</style>
