---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  hideNav?: boolean;
  lite?: boolean;
}
const {
  title = 'Betva',
  description = 'Betva — football betting and community for Tanzania. Fixed stakes, fast results, honest records.',
  active = '',
  hideNav = false,
  lite = false,
} = Astro.props;
const API = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f5f2" />
    <script src="/theme-init.js" is:inline></script>
    <meta name="betva-api" content={API} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href={API} crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <main class={hideNav ? '' : 'has-bottom-nav'}>
      <slot />
    </main>

    {!hideNav && (
    <nav class="bottom-nav" aria-label="Primary">
      <a href="/" data-astro-prefetch="tap" class={`nav-item ${active === 'home' ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg>
        <span>Home</span>
      </a>
      <a href="/community" data-astro-prefetch="tap" class={`nav-item ${active === 'community' ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span>Community</span>
      </a>
      <a href="/history" data-astro-prefetch="tap" class={`nav-item ${active === 'history' ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <span>History</span>
      </a>
      <a href="/profile" data-astro-prefetch="tap" class={`nav-item ${active === 'profile' ? 'active' : ''}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
        <span>Profile</span>
      </a>
      <button id="themeToggle" class="nav-item theme-toggle" type="button" aria-label="Switch to dark mode">
        <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </nav>
    )}

    {!lite && (
      <div id="breakBanner" class="nudge hidden" role="region" aria-label="Session reminder">
        <div class="flex items-center justify-between gap-2 mb-1">
          <div class="font-semibold">You've been here an hour</div>
          <span class="badge badge-pending">⏱ 60 MIN</span>
        </div>
        <p class="text-sm text-[var(--text-2)] mb-3">Take a break? Your access stays active and betting pauses if you choose.</p>
        <div class="flex gap-2">
          <button class="btn btn-primary flex-1" id="breakTake" type="button">Take a 3h break</button>
          <button class="btn btn-secondary" id="breakDismiss" type="button">Dismiss</button>
        </div>
        <div id="breakMsg" class="text-sm mt-2" aria-live="polite"></div>
      </div>
    )}

    {!lite && (
      <script>
        import { registerServiceWorker, watchPushChanges } from '../lib/push';
        import { API } from '../lib/api';

        // Appearance: the head script already set the initial theme before paint.
        const themeToggle = document.getElementById('themeToggle') as HTMLButtonElement | null;
        const applyTheme = (theme: 'light' | 'dark') => {
          document.documentElement.setAttribute('data-theme', theme);
          try { localStorage.setItem('betva_theme', theme); } catch { /* storage disabled */ }
          const themeMeta = document.querySelector('meta[name="theme-color"]');
          if (themeMeta) themeMeta.setAttribute('content', theme === 'dark' ? '#141719' : '#f6f5f2');
          if (themeToggle) {
            themeToggle.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
          }
        };
        if (themeToggle) {
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          themeToggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
          themeToggle.addEventListener('click', () => {
            applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
          });
        }

        watchPushChanges();

        // Defer service worker registration so it doesn't compete with first paint/data fetch.
        const ric = (window as any).requestIdleCallback as ((cb: () => void, opts?: { timeout: number }) => void) | undefined;
        if (typeof ric === 'function') {
          ric(() => registerServiceWorker(), { timeout: 2000 });
        } else {
          window.addEventListener('load', () => registerServiceWorker(), { once: true });
        }

        const HOUR_MS = 60 * 60 * 1000;
        const path = location.pathname;
        const token = localStorage.getItem('betva_token');
        const skip = path.startsWith('/admin') || path === '/login' || path === '/register';

        if (token && !skip) {
          const initNudge = () => {
            const KEY = 'betva_session_start';
            let start = Number(localStorage.getItem(KEY) || 0);
            if (!start || Number.isNaN(start)) {
              start = Date.now();
              localStorage.setItem(KEY, String(start));
            }

            const banner = document.getElementById('breakBanner');
            const check = () => {
              if (Date.now() - start >= HOUR_MS) banner?.classList.remove('hidden');
            };
            const timer = window.setInterval(check, 60_000);
            check();

            document.getElementById('breakDismiss')?.addEventListener('click', () => {
              banner?.classList.add('hidden');
              start = Date.now();
              localStorage.setItem(KEY, String(start));
            });

            document.getElementById('breakTake')?.addEventListener('click', async () => {
              const btn = document.getElementById('breakTake') as HTMLButtonElement | null;
              const msg = document.getElementById('breakMsg')!;
              if (!btn) return;
              btn.disabled = true;
              btn.textContent = 'Pausing…';
              try {
                const res = await fetch(`${API}/api/v1/self-exclusion`, {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                    Authorization: `Bearer ${localStorage.getItem('betva_token') || ''}`,
                  },
                  body: JSON.stringify({ hours: 3 }),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) {
                  msg.textContent = data.error || 'Could not pause betting.';
                  msg.className = 'text-sm mt-2 text-[var(--danger)]';
                  btn.disabled = false;
                  btn.textContent = 'Take a 3h break';
                  return;
                }
                msg.textContent = `Betting paused until ${data.until}. You can still browse.`;
                msg.className = 'text-sm mt-2 text-[var(--success)]';
                btn.remove();
                window.clearInterval(timer);
                setTimeout(() => banner?.classList.add('hidden'), 5000);
              } catch {
                msg.textContent = 'Network error. Try again.';
                msg.className = 'text-sm mt-2 text-[var(--danger)]';
                btn.disabled = false;
                btn.textContent = 'Take a 3h break';
              }
            });
          };
          // Defer non-critical session-nudge setup so initial render/data work runs first.
          if ('requestIdleCallback' in window) {
            (window as any).requestIdleCallback(initNudge, { timeout: 3000 });
          } else {
            setTimeout(initNudge, 500);
          }
        }
      </script>
    )}
  </body>
</html>
