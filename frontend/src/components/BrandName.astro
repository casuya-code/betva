---
interface Props {
  tag?: string;
  class?: string;
}

const { tag = 'span', class: className = '' } = Astro.props;
const Tag = tag as any;
// "Betva" -> B e t v a with Google colours.
const letters = [
  { ch: 'B', key: 'b' },
  { ch: 'e', key: 'e' },
  { ch: 't', key: 't' },
  { ch: 'v', key: 'v' },
  { ch: 'a', key: 'a' },
];
---
<Tag class:list={['brand-name', className]} aria-label="Betva">
  {letters.map((l) => <span class={`brand-letter brand-${l.key}`} aria-hidden="true">{l.ch}</span>)}
</Tag>

<style>
  .brand-name {
    font-weight: inherit;
    letter-spacing: -0.01em;
  }
  .brand-letter {
    display: inline-block;
  }
  .brand-b {
    color: #4285f4;
  }
  .brand-e {
    color: #ea4335;
  }
  .brand-t {
    color: #fbbc05;
  }
  .brand-v {
    color: #34a853;
  }
  .brand-a {
    color: #ea4335;
  }
</style>
