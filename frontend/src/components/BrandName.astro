---
interface Props {
  tag?: string;
  class?: string;
}

const { tag = 'span', class: className = '' } = Astro.props;
const Tag = tag as any;
// "Betva" -> B e t v a with Google logo colours.
const letters = [
  { ch: 'B', color: '#4285F4' },
  { ch: 'e', color: '#EA4335' },
  { ch: 't', color: '#FBBC05' },
  { ch: 'v', color: '#34A853' },
  { ch: 'a', color: '#EA4335' },
];
---
<Tag class:list={['brand-name', className]} aria-label="Betva">
  {letters.map((l) => <span style={`color:${l.color}`} aria-hidden="true">{l.ch}</span>)}
</Tag>

<style>
  .brand-name {
    font-weight: inherit;
    letter-spacing: -0.01em;
  }
  .brand-name span {
    display: inline-block;
  }
</style>