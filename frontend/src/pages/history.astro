---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Betva — History" active="history">
  <div class="px-4 pt-4 space-y-4">
    <h1 class="text-2xl font-bold">History</h1>
    <p class="text-sm text-[var(--text-2)]">Last 6 months of your bets.</p>
    <div id="list" class="space-y-3">
      <div class="card"><div class="skeleton h-16"></div></div>
      <div class="card"><div class="skeleton h-16"></div></div>
    </div>
  </div>
  <script>
    const API = (window as any).BETVA_API;
    const token = localStorage.getItem('betva_token');
    async function load() {
      if (!token) { window.location.href = '/login'; return; }
      const res = await fetch(`${API}/api/v1/history`, { headers: { Authorization: `Bearer ${token}` } });
      const data = await res.json();
      const el = document.getElementById('list')!;
      if (!data.bets || data.bets.length === 0) {
        el.innerHTML = '<div class="card text-center text-[var(--text-2)]">No bets yet.</div>';
        return;
      }
      el.innerHTML = data.bets.map((b: any) => `
        <div class="card flex items-center justify-between">
          <div>
            <div class="font-semibold">${b.match || 'Match'}</div>
            <div class="text-xs text-[var(--text-3)]">${b.market} · ${b.placed_at}</div>
          </div>
          <div class="text-right">
            <div class="counter">${b.stake} TZS</div>
            <span class="badge badge-${b.status === 'win' ? 'win' : b.status === 'loss' ? 'loss' : b.status === 'pending' ? 'pending' : 'postponed'}">${b.status.toUpperCase()}</span>
          </div>
        </div>
      `).join('');
    }
    load();
  </script>
</Layout>
