---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Betva — History" description="Your settled Betva results: every win, every loss, and every wallet movement." active="history">
  <div class="page-frame page-frame-wide">
    <header class="mb-4">
      <h1 class="text-2xl font-bold">History</h1>
      <p class="text-sm text-[var(--text-2)]">Slips placed by <strong>your account</strong> in the last 6 months. Wins and losses both stay here. The Betva track record on Home is the combined count across all users.</p>
    </header>

    <div class="page-split">
      <aside class="page-split-aside space-y-4">
        <!-- Personal record -->
        <div class="glass p-4">
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm text-[var(--text-2)]">Your record</span>
            <span class="text-xs text-[var(--text-3)]" id="h-range">—</span>
          </div>
          <div class="grid grid-cols-4 gap-2 text-center">
            <div>
              <div class="text-xl font-bold counter" id="h-settled">—</div>
              <div class="text-[11px] text-[var(--text-3)]">Settled</div>
            </div>
            <div>
              <div class="text-xl font-bold counter text-green-400" id="h-wins">—</div>
              <div class="text-[11px] text-[var(--text-3)]">Wins</div>
            </div>
            <div>
              <div class="text-xl font-bold counter text-red-400" id="h-losses">—</div>
              <div class="text-[11px] text-[var(--text-3)]">Losses</div>
            </div>
            <div>
              <div class="text-xl font-bold counter" id="h-rate">—</div>
              <div class="text-[11px] text-[var(--text-3)]">Win rate</div>
            </div>
          </div>
        </div>

        <section class="card hidden lg:block space-y-2 text-sm text-[var(--text-2)]" aria-labelledby="about-record">
          <h2 class="font-semibold text-[var(--text)]" id="about-record">About this record</h2>
          <p>Six months of bets, newest first. A correction is added as a new reversing entry — the original result and payout stay visible.</p>
          <a href="/" class="btn btn-secondary w-full">Back to matches</a>
        </section>
      </aside>

      <div class="page-split-main">
        <div class="flex items-center justify-between gap-2 mb-3">
          <h2 class="text-lg font-semibold">All bets</h2>
          <span class="text-xs text-[var(--text-3)]" id="h-count"></span>
        </div>

        <div id="list" class="space-y-3">
          <div class="card"><div class="skeleton h-24"></div></div>
          <div class="card"><div class="skeleton h-24"></div></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { authFetch, esc, money, MARKET_LABEL, betStatus, toast } from '../lib/api';

    type Bet = {
      id: string;
      market: string;
      stake_cents: number;
      status: string;
      payout_cents: number;
      placed_at: string;
      match_id: string;
      match_date: string;
      kickoff: string;
      league: string;
      home_team: string;
      away_team: string;
      home_goals: number | null;
      away_goals: number | null;
      home_goals_ht: number | null;
      away_goals_ht: number | null;
      match_status: string;
      confidence: string;
      void_reason: string | null;
    };

    function score(b: Bet): string {
      if (b.home_goals === null || b.away_goals === null) return '—';
      let s = `${b.home_goals}–${b.away_goals}`;
      if (b.home_goals_ht !== null && b.away_goals_ht !== null) {
        s += ` <span class="text-[var(--text-3)]">(HT ${b.home_goals_ht}–${b.away_goals_ht})</span>`;
      }
      return s;
    }

    function render(bets: Bet[]) {
      const list = document.getElementById('list')!;
      if (!bets.length) {
        list.innerHTML =
          '<div class="card text-center text-[var(--text-2)]">No slips from your account yet. Only bets you place appear here. The Betva track record on Home combines settled tips from everyone.</div>';
        return;
      }

      list.innerHTML = bets
        .map((b) => {
          const st = betStatus(b.status);
          const payout =
            b.status === 'win'
              ? `<div class="text-green-400 counter">+${money(b.payout_cents)} TZS</div>`
              : b.status === 'refunded'
                ? `<div class="text-[var(--text-2)] counter">${money(b.stake_cents)} TZS returned</div>`
                : b.status === 'loss'
                  ? `<div class="text-red-400 counter">−${money(b.stake_cents)} TZS</div>`
                  : `<div class="text-[var(--text-2)] counter">${money(b.stake_cents)} TZS at stake</div>`;

          const reason = b.void_reason
            ? `<div class="mt-2 text-xs text-[var(--text-3)]">Reason: ${esc(b.void_reason)}</div>`
            : '';

          return `
            <div class="card">
              <div class="flex items-start justify-between gap-2 mb-2">
                <span class="text-xs text-[var(--text-3)] leading-snug break-words">
                  ${esc(b.league || 'Match')} · ${esc(b.match_date)} ${esc(b.kickoff)}
                </span>
                <span class="badge ${st.cls} shrink-0">${st.label}</span>
              </div>

              <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3">
                <div class="font-semibold leading-tight break-words">${esc(b.home_team)}</div>
                <div class="counter text-sm">${score(b)}</div>
                <div class="font-semibold leading-tight break-words text-right">${esc(b.away_team)}</div>
              </div>

              <div class="mt-2 flex items-center justify-between gap-2 text-sm">
                <span class="badge badge-pending">${esc(MARKET_LABEL[b.market] || b.market)}</span>
                <span class="text-xs text-[var(--text-3)]">Placed ${esc(b.placed_at)}</span>
              </div>

              <div class="mt-3 pt-3 border-t border-[var(--border)] flex items-end justify-between">
                <div>
                  <div class="text-xs text-[var(--text-3)]">Stake</div>
                  <div class="counter">${money(b.stake_cents)} TZS</div>
                </div>
                <div class="text-right">
                  <div class="text-xs text-[var(--text-3)]">${b.status === 'win' ? 'Payout' : b.status === 'pending' ? 'Potential' : 'Result'}</div>
                  ${payout}
                </div>
              </div>
              ${reason}
            </div>`;
        })
        .join('');
    }

    function summarise(bets: Bet[]) {
      const settled = bets.filter((b) => b.status === 'win' || b.status === 'loss');
      const wins = bets.filter((b) => b.status === 'win').length;
      const losses = bets.filter((b) => b.status === 'loss').length;
      const rate = settled.length ? Math.round((wins / settled.length) * 100) : 0;

      document.getElementById('h-settled')!.textContent = String(settled.length);
      document.getElementById('h-wins')!.textContent = String(wins);
      document.getElementById('h-losses')!.textContent = String(losses);
      document.getElementById('h-rate')!.textContent = settled.length ? `${rate}%` : '—';

      document.getElementById('h-count')!.textContent = `${bets.length} bet${bets.length === 1 ? '' : 's'}`;
      document.getElementById('h-range')!.textContent = 'Last 6 months';
    }

    async function load() {
      try {
        const res = await authFetch('/api/v1/history');
        if (!res.ok) throw new Error('failed');
        const data = await res.json().catch(() => ({}));
        const bets: Bet[] = data.bets || [];
        summarise(bets);
        render(bets);
      } catch {
        document.getElementById('list')!.innerHTML =
          '<div class="card text-center text-[var(--text-2)]">Could not load your history. Check your connection and try again.</div>';
        toast('Could not load history', 'error');
      }
    }

    load();
  </script>
</Layout>
