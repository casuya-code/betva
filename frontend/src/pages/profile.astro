---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Betva — Profile" active="profile">
  <div class="px-4 pt-4 space-y-4">
    <h1 class="text-2xl font-bold">Profile</h1>

    <div class="glass p-4 space-y-3">
      <div class="flex items-center gap-3">
        <div class="w-14 h-14 rounded-full bg-[var(--surface-el)] flex items-center justify-center text-xl">👤</div>
        <div>
          <div class="font-semibold" id="p-nickname">—</div>
          <div class="text-sm text-[var(--text-2)]" id="p-phone">—</div>
          <span class="badge badge-pending" id="p-status">—</span>
        </div>
      </div>
    </div>

    <div class="glass p-4">
      <h3 class="font-semibold mb-3">Account status</h3>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between"><span class="text-[var(--text-2)]">Status</span><span id="p-astatus">—</span></div>
        <div class="flex justify-between"><span class="text-[var(--text-2)]">Balance</span><span class="counter" id="p-balance">—</span></div>
        <div class="flex justify-between"><span class="text-[var(--text-2)]">Expires</span><span id="p-expiry">—</span></div>
      </div>
    </div>

    <div class="glass p-4">
      <h3 class="font-semibold mb-3">Payment &amp; activation</h3>
      <p class="text-sm text-[var(--text-2)] mb-3">
        To activate or renew, pay via mobile money to the admin number below, then wait for manual activation.
      </p>
      <div class="glass-el p-3 text-center">
        <div class="text-xs text-[var(--text-3)]">Admin payment number</div>
        <div class="text-lg font-bold counter" id="admin-number">+255 700 000 000</div>
      </div>
      <p class="text-xs text-[var(--text-3)] mt-2">Keep your transaction reference number.</p>
    </div>

    <div class="glass p-4 space-y-3">
      <h3 class="font-semibold">Edit profile</h3>
      <form id="editForm" class="space-y-3">
        <div>
          <label class="text-sm text-[var(--text-2)] mb-1 block">New password</label>
          <input class="input" name="password" type="password" minlength="6" />
        </div>
        <button class="btn btn-secondary w-full" type="submit">Save changes</button>
      </form>
      <div id="msg" class="text-center text-sm"></div>
    </div>

    <button id="logoutBtn" class="btn btn-danger w-full">Logout</button>
  </div>

  <script>
    const API = (window as any).BETVA_API;
    const token = localStorage.getItem('betva_token');
    async function authFetch(path: string, opts: any = {}) {
      const r = await fetch(`${API}${path}`, {
        ...opts,
        headers: { ...(opts.headers || {}), Authorization: `Bearer ${token}` },
      });
      return r;
    }
    async function load() {
      if (!token) { window.location.href = '/login'; return; }
      const res = await authFetch('/api/v1/me');
      if (!res.ok) { window.location.href = '/login'; return; }
      const d = await res.json();
      (document.getElementById('p-nickname') as HTMLElement).textContent = d.nickname;
      (document.getElementById('p-phone') as HTMLElement).textContent = d.phone;
      (document.getElementById('p-status') as HTMLElement).textContent = d.status.toUpperCase();
      (document.getElementById('p-astatus') as HTMLElement).textContent = d.status;
      (document.getElementById('p-balance') as HTMLElement).textContent = (d.balance_cents / 100).toFixed(0);
      (document.getElementById('p-expiry') as HTMLElement).textContent = '—';
    }
    load();

    const form = document.getElementById('editForm') as HTMLFormElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const pw = fd.get('password');
      if (!pw) return;
      const res = await authFetch('/api/v1/me', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: pw }),
      });
      const data = await res.json();
      const msg = document.getElementById('msg')!;
      msg.textContent = res.ok ? 'Saved.' : (data.error || 'Failed');
      msg.className = res.ok ? 'text-center text-sm text-green-400' : 'text-center text-sm text-red-400';
    });

    document.getElementById('logoutBtn')!.addEventListener('click', () => {
      localStorage.removeItem('betva_token');
      window.location.href = '/login';
    });
  </script>
</Layout>
