---
import Layout from '../layouts/Layout.astro';
import TrackRecord from '../components/TrackRecord.astro';
---
<Layout title="Betva — Profile" description="Your Betva wallet, notification settings, and self-exclusion controls." active="profile">
  <div class="page-frame space-y-4">
    <h1 class="text-2xl font-bold">Profile</h1>

    <div class="glass p-4 space-y-3">
      <div class="flex items-center gap-3">
        <div class="w-14 h-14 rounded-full bg-[var(--surface-el)] flex items-center justify-center text-xl" aria-hidden="true">👤</div>
        <div class="min-w-0">
          <div class="font-semibold truncate" id="p-nickname">—</div>
          <div class="text-sm text-[var(--text-2)]" id="p-phone">—</div>
          <span class="badge badge-pending" id="p-status">—</span>
        </div>
      </div>
    </div>

    <!-- Track record (aggregate, same for everyone) -->
    <TrackRecord />

    <!-- Wallet -->
    <div class="glass p-4">
      <div class="flex items-center justify-between mb-1">
        <h2 class="font-semibold">Wallet</h2>
        <span class="text-xs text-[var(--text-3)]">Balance</span>
      </div>
      <div class="text-3xl font-bold counter" id="p-balance">—</div>
      <div class="text-sm text-[var(--text-2)]">TZS available</div>

      <div class="mt-3 grid grid-cols-2 gap-2 text-sm">
        <div class="glass-el p-3">
          <div class="text-xs text-[var(--text-3)]">Account status</div>
          <div id="p-astatus">—</div>
        </div>
        <div class="glass-el p-3">
          <div class="text-xs text-[var(--text-3)]">Access expires</div>
          <div id="p-expiry">—</div>
        </div>
      </div>
    </div>

    <!-- Ledger -->
    <div class="glass p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold">Recent activity</h2>
        <span class="text-xs text-[var(--text-3)]">Last 50 entries</span>
      </div>
      <div id="ledger" class="text-sm text-[var(--text-2)]">Loading…</div>
    </div>

    <!-- Inbox -->
    <div class="glass p-4">
      <div class="flex items-center justify-between mb-3 gap-2 flex-wrap">
        <h2 class="font-semibold">Notifications</h2>
        <div class="flex items-center gap-2 flex-wrap">
          <span class="badge badge-pending" id="unreadBadge">0 UNREAD</span>
          <button class="btn btn-ghost text-xs" id="markAll" type="button">Mark all read</button>
        </div>
      </div>
      <div id="inbox" class="text-sm text-[var(--text-2)]">Loading…</div>
    </div>

    <!-- Notification preferences -->
    <div class="glass p-4 space-y-3">
      <h2 class="font-semibold">Notification settings</h2>
      <p class="text-xs text-[var(--text-3)]">
        Push is capped at 2 per day and stays silent 22:00–07:00 EAT. The inbox below always works, even if push is blocked.
      </p>

      <div class="glass-el p-3 flex items-center justify-between gap-3">
        <div>
          <div class="text-sm font-medium">Push on this device</div>
          <div class="text-xs text-[var(--text-3)]" id="pushStatus">Checking…</div>
        </div>
        <button class="btn btn-secondary text-sm" id="enablePushBtn" type="button">Enable</button>
      </div>
      <div id="pushMsg" class="text-sm" aria-live="polite"></div>

      <div id="prefList" class="space-y-1"></div>
    </div>

    <!-- Self-exclusion -->
    <div class="glass p-4 space-y-3">
      <div class="flex items-center justify-between gap-2">
        <h2 class="font-semibold">Take a break</h2>
        <span class="badge badge-pending" id="exclusionBadge">NOT ACTIVE</span>
      </div>
      <p class="text-sm text-[var(--text-2)]">
        Lock betting for a set period. Your balance stays safe, you can still browse, and the pause cannot be shortened.
      </p>
      <div id="exclusionStatus" class="text-sm text-[var(--text-2)]"></div>
      <div class="grid grid-cols-3 gap-2">
        <button class="btn btn-secondary text-sm exclusion" data-hours="24" type="button">24 hours</button>
        <button class="btn btn-secondary text-sm exclusion" data-hours="168" type="button">7 days</button>
        <button class="btn btn-secondary text-sm exclusion" data-hours="720" type="button">30 days</button>
      </div>
      <div id="exclusionMsg" class="text-sm" aria-live="polite"></div>
    </div>

    <div class="glass p-4">
      <h2 class="font-semibold mb-3">Deposit &amp; activation</h2>
      <p class="text-sm text-[var(--text-2)] mb-3">
        Pay via mobile money to the admin number below, then send your transaction reference.
        Deposits and access activation are applied manually by an admin.
      </p>
      <div class="glass-el p-3 text-center">
        <div class="text-xs text-[var(--text-3)]">Monthly access rate</div>
        <div class="text-lg font-bold counter" id="access-fee">—</div>
        <div class="text-xs text-[var(--text-3)]" id="access-fee-note"></div>
      </div>
      <div class="glass-el p-3 text-center mt-2">
        <div class="text-xs text-[var(--text-3)]">Admin payment number</div>
        <div class="text-lg font-bold counter" id="admin-number">+255 700 000 000</div>
      </div>
      <p class="text-xs text-[var(--text-3)] mt-2">Every wallet movement is recorded in the ledger above — nothing is edited or removed.</p>
    </div>

    <div class="glass p-4 space-y-3">
      <h2 class="font-semibold">Edit profile</h2>
      <form id="editForm" class="space-y-3">
        <div>
          <label class="text-sm text-[var(--text-2)] mb-1 block" for="pw">New password</label>
          <input class="input" id="pw" name="password" type="password" minlength="6" autocomplete="new-password" />
        </div>
        <button class="btn btn-secondary w-full" type="submit">Save changes</button>
      </form>
      <div id="msg" class="text-center text-sm" aria-live="polite"></div>
    </div>

    <button id="logoutBtn" class="btn btn-danger w-full" type="button">Logout</button>
  </div>

  <script>
    import { API, authFetch, esc, money, clearToken, toast } from '../lib/api';
    import { enablePush, pushSupported } from '../lib/push';

    const statusClass: Record<string, string> = {
      active: 'badge-win',
      inactive: 'badge-pending',
      suspended: 'badge-live',
      banned: 'badge-loss',
    };

    const REASON_LABEL: Record<string, string> = {
      bet_placed: 'Slip placed',
      bet_won: 'Winning payout',
      bet_refund: 'Stake refunded',
      bet_correction_reversal: 'Correction reversal',
    };

    const CATEGORY_LABEL: Record<string, string> = {
      match_start: 'Match starting soon',
      results: 'Results & payouts',
      account: 'Account & payments',
      announcements: 'Announcements',
      community: 'Community activity',
    };

    function reasonLabel(reason: string): string {
      if (REASON_LABEL[reason]) return REASON_LABEL[reason];
      if (reason.startsWith('admin_adjustment:')) return reason.replace('admin_adjustment:', 'Admin:').trim();
      return reason.replace(/_/g, ' ');
    }

    async function loadFee() {
      // The flat rate the admin set. Users see only the rate — never the
      // admin's targets, costs, or planning figures.
      try {
        const res = await fetch(`${API}/api/v1/config`);
        const cfg = await res.json().catch(() => ({}));
        const feeEl = document.getElementById('access-fee');
        const noteEl = document.getElementById('access-fee-note');
        if (!feeEl) return;
        if (cfg.access_fee_cents && cfg.access_fee_cents > 0) {
          feeEl.textContent = `${money(cfg.access_fee_cents)} TZS`;
          if (noteEl) noteEl.textContent = 'per month · contribution to running costs';
        } else {
          feeEl.textContent = 'Ask the admin';
          if (noteEl) noteEl.textContent = 'rate not published yet';
        }
      } catch {
        /* keep the placeholder */
      }
    }

    async function loadMe() {
      const res = await authFetch('/api/v1/me');
      if (!res.ok) return;
      const d = await res.json().catch(() => ({}));
      document.getElementById('p-nickname')!.textContent = d.nickname || '—';
      document.getElementById('p-phone')!.textContent = d.phone || '—';

      const statusEl = document.getElementById('p-status')!;
      statusEl.textContent = (d.status || 'unknown').toUpperCase();
      statusEl.className = `badge ${statusClass[d.status] || 'badge-pending'}`;

      document.getElementById('p-astatus')!.textContent = d.status || '—';
      document.getElementById('p-expiry')!.textContent = d.access_expires_at
        ? String(d.access_expires_at).slice(0, 10)
        : 'No active period';
    }

    async function loadWallet() {
      const res = await authFetch('/api/v1/wallet');
      if (!res.ok) throw new Error('failed');
      const d = await res.json().catch(() => ({}));

      if (document.getElementById('p-balance')) {
        document.getElementById('p-balance')!.textContent = money(d.balance_cents);
      }

      const entries: Array<{ amount_cents: number; reason: string; created_at: string }> = d.entries || [];
      const el = document.getElementById('ledger');
      if (!el) return;
      if (!entries.length) {
        el.innerHTML = '<div class="text-[var(--text-3)]">No wallet activity yet.</div>';
        return;
      }

      el.innerHTML = `
        <ul class="divide-y divide-[var(--border)]">
          ${entries
            .map((e) => {
              const positive = e.amount_cents > 0;
              return `
                <li class="flex items-center justify-between gap-3 py-2">
                  <div class="min-w-0">
                    <div class="leading-snug break-words">${esc(reasonLabel(e.reason))}</div>
                    <div class="text-xs text-[var(--text-3)]">${esc(e.created_at)}</div>
                  </div>
                  <div class="counter shrink-0 ${positive ? 'text-green-400' : 'text-red-400'}">
                    ${positive ? '+' : '−'}${money(Math.abs(e.amount_cents))}
                  </div>
                </li>`;
            })
            .join('')}
        </ul>`;
    }

    async function loadInbox() {
      const res = await authFetch('/api/v1/notifications?limit=20');
      if (!res.ok) {
        document.getElementById('inbox')!.textContent = 'Could not load notifications. Check your connection.';
        return;
      }
      const d = await res.json().catch(() => ({}));
      const items: Array<any> = d.notifications || [];
      const el = document.getElementById('inbox')!;
      document.getElementById('unreadBadge')!.textContent = `${d.unread || 0} UNREAD`;

      if (!items.length) {
        el.innerHTML = '<div class="text-[var(--text-3)]">Nothing yet. Results and account updates land here.</div>';
        return;
      }

      el.innerHTML = `
        <ul class="divide-y divide-[var(--border)]">
          ${items
            .map(
              (n) => `
              <li class="py-2 ${n.read ? 'opacity-60' : ''}" data-notif="${esc(n.id)}" data-link="${esc(n.link)}">
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0">
                    <div class="font-medium text-[var(--text)]">${esc(n.title)}</div>
                    <div class="text-[var(--text-2)]">${esc(n.body)}</div>
                    <div class="text-xs text-[var(--text-3)]">${esc(CATEGORY_LABEL[n.category] || n.category)} · ${esc(n.created_at)}</div>
                  </div>
                  ${n.read ? '' : '<span class="badge badge-win shrink-0">NEW</span>'}
                </div>
              </li>`
            )
            .join('')}
        </ul>`;

      el.querySelectorAll('[data-notif]').forEach((li) => {
        li.addEventListener('click', async () => {
          const id = (li as HTMLElement).dataset.notif!;
          const link = (li as HTMLElement).dataset.link!;
          try {
            await authFetch(`/api/v1/notifications/${id}/read`, { method: 'POST' });
          } catch {
            /* keep the inbox usable even if the read mark fails */
          }
          if (link) {
            window.location.href = link;
          } else {
            (li as HTMLElement).classList.add('opacity-60');
            (li.querySelector('.badge') as HTMLElement | null)?.remove();
          }
        });
      });
    }

    document.getElementById('markAll')!.addEventListener('click', async () => {
      try {
        await authFetch('/api/v1/notifications/read-all', { method: 'POST' });
        await loadInbox();
      } catch {
        toast('Could not mark notifications as read', 'error');
      }
    });

    type Prefs = {
      match_start: boolean;
      results: boolean;
      account: boolean;
      announcements: boolean;
      community: boolean;
    };

    async function loadPrefs() {
      const res = await authFetch('/api/v1/notifications/prefs');
      if (!res.ok) {
        document.getElementById('prefList')!.innerHTML =
          '<div class="text-sm text-[var(--text-3)]">Could not load preferences.</div>';
        return;
      }
      const prefs: Prefs = await res.json().catch(() => ({}));
      const el = document.getElementById('prefList')!;
      const keys = Object.keys(CATEGORY_LABEL) as Array<keyof Prefs>;

      el.innerHTML = keys
        .map(
          (key) => `
          <label class="flex items-center justify-between gap-3 py-2 border-b border-[var(--border)] last:border-0">
            <span class="text-sm">${esc(CATEGORY_LABEL[key])}</span>
            <input type="checkbox" class="pref-toggle" data-key="${key}" ${prefs[key] ? 'checked' : ''} />
          </label>`
        )
        .join('');

      el.querySelectorAll('.pref-toggle').forEach((input) => {
        input.addEventListener('change', async (e) => {
          const target = e.target as HTMLInputElement;
          const key = target.dataset.key!;
          const next = target.checked;
          try {
            const res2 = await authFetch('/api/v1/notifications/prefs', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ [key]: next }),
            });
            if (res2.ok) {
              toast(next ? 'Notifications on for this type' : 'Muted this notification type');
            } else {
              target.checked = !next;
              toast('Could not save the preference', 'error');
            }
          } catch {
            target.checked = !next;
            toast('Could not save the preference', 'error');
          }
        });
      });
    }

    function pushStatus() {
      const el = document.getElementById('pushStatus')!;
      const btn = document.getElementById('enablePushBtn') as HTMLButtonElement;
      if (!pushSupported()) {
        el.textContent = 'This browser cannot receive push. The inbox still works.';
        btn.disabled = true;
        return;
      }
      if (Notification.permission === 'granted') {
        el.textContent = 'On — capped at 2/day, silent 22:00–07:00 EAT.';
        btn.textContent = 'Refresh';
      } else if (Notification.permission === 'denied') {
        el.textContent = 'Blocked in browser settings. The inbox still works.';
        btn.disabled = true;
      } else {
        el.textContent = 'Off. Turn on only if you want match and result alerts.';
      }
    }

    document.getElementById('enablePushBtn')!.addEventListener('click', async () => {
      const btn = document.getElementById('enablePushBtn') as HTMLButtonElement;
      const msg = document.getElementById('pushMsg')!;
      btn.disabled = true;
      const result = await enablePush();
      msg.textContent = result.message;
      msg.className = `text-sm ${result.ok ? 'text-green-400' : 'text-[var(--text-2)]'}`;
      pushStatus();
      btn.disabled = false;
    });

    async function loadExclusion() {
      const res = await authFetch('/api/v1/self-exclusion');
      if (!res.ok) return;
      const d = await res.json().catch(() => ({}));
      const badge = document.getElementById('exclusionBadge')!;
      const status = document.getElementById('exclusionStatus')!;
      const buttons = document.querySelectorAll<HTMLButtonElement>('.exclusion');

      if (d.active) {
        badge.textContent = 'PAUSED';
        badge.className = 'badge badge-postponed';
        status.textContent = `Betting is paused until ${d.until}. This cannot be shortened.`;
        buttons.forEach((b) => (b.disabled = true));
      } else {
        badge.textContent = 'NOT ACTIVE';
        badge.className = 'badge badge-pending';
        status.textContent = 'No pause is active. Choose a period if you want to stop betting for a while.';
        buttons.forEach((b) => (b.disabled = false));
      }
    }

    document.querySelectorAll<HTMLButtonElement>('.exclusion').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const hours = Number(btn.dataset.hours);
        const label = hours === 24 ? '24 hours' : hours === 168 ? '7 days' : '30 days';
        if (!confirm(`Pause betting for ${label}? This cannot be undone early.`)) return;

        const msg = document.getElementById('exclusionMsg')!;
        btn.disabled = true;
        try {
          const res = await authFetch('/api/v1/self-exclusion', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ hours }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            msg.textContent = data.error || 'Could not pause betting.';
            msg.className = 'text-sm text-red-400';
            return;
          }
          msg.textContent = `Betting paused until ${data.until}.`;
          msg.className = 'text-sm text-green-400';
          await loadExclusion();
        } catch {
          msg.textContent = 'Could not pause betting. Check your connection.';
          msg.className = 'text-sm text-red-400';
        } finally {
          btn.disabled = false;
        }
      });
    });

    // Load in parallel: on a slow connection five serial round-trips is five
    // times the wait. One failing section must not block the others.
    (async () => {
      const results = await Promise.allSettled([
        loadMe(),
        loadWallet(),
        loadInbox(),
        loadPrefs(),
        loadExclusion(),
        loadFee(),
      ]);
      pushStatus();
      if (results.some((r) => r.status === 'rejected')) {
        toast('Some profile sections could not load. Pull to refresh.', 'error');
      }
    })();

    const form = document.getElementById('editForm') as HTMLFormElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pw = (new FormData(form).get('password') || '').toString();
      const msg = document.getElementById('msg')!;
      if (!pw) return;
      try {
        const res = await authFetch('/api/v1/me', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: pw }),
        });
        const data = await res.json().catch(() => ({}));
        msg.textContent = res.ok ? 'Saved.' : data.error || 'Failed';
        msg.className = res.ok ? 'text-center text-sm text-green-400' : 'text-center text-sm text-red-400';
        if (res.ok) form.reset();
      } catch {
        msg.textContent = 'Could not save changes. Check your connection.';
        msg.className = 'text-center text-sm text-red-400';
      }
    });

    document.getElementById('logoutBtn')!.addEventListener('click', () => {
      clearToken();
      localStorage.removeItem('betva_session_start');
      localStorage.removeItem('betva_push_asked');
      window.location.href = '/login';
    });
  </script>
</Layout>
