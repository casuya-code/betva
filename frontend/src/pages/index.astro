---
import Layout from '../layouts/Layout.astro';
import TrackRecord from '../components/TrackRecord.astro';
import BrandName from '../components/BrandName.astro';
---
<Layout title="Betva — Home" description="Today’s and tomorrow’s football matches. Fixed stakes, fast settlement, honest records." active="home">
  <div class="page-frame page-frame-wide">
    <!-- Header -->
    <header class="flex items-center justify-between gap-2 mb-4">
      <div class="flex items-center gap-2 min-w-0">
        <img src="/favicon.svg" alt="" class="w-8 h-8 rounded-lg shrink-0" width="32" height="32" decoding="async" fetchpriority="high" />
        <h1 class="text-2xl font-bold tracking-tight"><BrandName /></h1>
      </div>
      <a href="/profile" class="tap-link text-sm text-[var(--text-2)] shrink-0">Profile</a>
    </header>

    <div class="page-split">
      <!-- Trust counter, plus the desktop-only rules rail -->
      <aside class="page-split-aside space-y-4">
        <TrackRecord />

        <section class="card hidden lg:block space-y-3" aria-labelledby="rules-title">
          <h2 class="font-semibold" id="rules-title">Rules</h2>
          <ul class="space-y-2 text-sm text-[var(--text-2)]">
            <li class="flex gap-2"><span class="text-[var(--brand)] font-semibold" aria-hidden="true">1.</span><span>Two markets only: <strong class="text-[var(--text)]">Full Time Over 0.5</strong> and <strong class="text-[var(--text)]">Half Time Over 0.5</strong>.</span></li>
            <li class="flex gap-2"><span class="text-[var(--brand)] font-semibold" aria-hidden="true">2.</span><span>Fixed stakes only — pick a tier, never type an amount.</span></li>
            <li class="flex gap-2"><span class="text-[var(--brand)] font-semibold" aria-hidden="true">3.</span><span>Betting closes at kickoff. Results settle after full time.</span></li>
            <li class="flex gap-2"><span class="text-[var(--brand)] font-semibold" aria-hidden="true">4.</span><span>Wins and losses stay in History for 6 months.</span></li>
          </ul>
          <div class="pt-3 border-t border-[var(--border)] flex flex-col gap-2">
            <a href="/history" class="btn btn-secondary w-full">View your record</a>
            <a href="/profile" class="btn btn-ghost w-full text-sm">Take a break or set limits</a>
          </div>
        </section>
      </aside>

      <!-- Matches -->
      <div class="page-split-main">
        <div class="flex items-baseline justify-between gap-2 mb-3">
          <h2 class="text-lg font-semibold shrink-0">Matches</h2>
          <span class="text-xs text-[var(--text-3)] text-right min-w-0">Bets close at kickoff</span>
        </div>
        <div class="day-tabs" id="day-tabs" role="tablist" aria-label="Match day">
          <button type="button" class="day-tab active" id="tab-today" role="tab" aria-selected="true" aria-controls="matches" data-day="today">
            <span class="dt-label">Today</span>
            <span class="dt-sub" id="tab-today-sub">—</span>
          </button>
          <button type="button" class="day-tab" id="tab-tomorrow" role="tab" aria-selected="false" aria-controls="matches" data-day="tomorrow">
            <span class="dt-label">Tomorrow</span>
            <span class="dt-sub" id="tab-tomorrow-sub">—</span>
          </button>
        </div>
        <div id="previewNote" class="card hidden mb-3 text-sm text-[var(--text-2)]" role="status">
          Preview of 3 matches. Pay the official number on your Profile, then ask the admin to activate you.
        </div>
        <div id="matches" class="mt-3 space-y-3" role="tabpanel" aria-label="Match list">
          <div class="card" aria-hidden="true"><div class="skeleton h-36"></div></div>
          <div class="card" aria-hidden="true"><div class="skeleton h-36"></div></div>
          <div class="card" aria-hidden="true"><div class="skeleton h-36"></div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bet slip -->
  <div id="slip" class="slip-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="slip-title">
    <div class="slip-sheet">
      <div class="slip-grip"></div>
      <h2 id="slip-title" class="text-lg font-bold">Place slip</h2>
      <div id="slip-match" class="text-sm text-[var(--text-2)] mt-1"></div>

      <div class="mt-3 flex items-center gap-2 flex-wrap">
        <span class="badge badge-pending" id="slip-market">—</span>
        <span class="badge badge-pending" id="slip-conf">—</span>
        <span class="badge badge-pending" id="slip-odds">—</span>
      </div>

      <div class="mt-4">
        <div class="text-sm text-[var(--text-2)] mb-2">Stake</div>
        <div id="stake-tiers" class="grid grid-cols-4 gap-2"></div>
      </div>

      <div class="mt-4 flex items-center justify-between text-sm">
        <span class="text-[var(--text-2)]">Potential return</span>
        <span class="counter text-lg" id="slip-return">—</span>
      </div>
      <p class="text-xs text-[var(--text-3)] mt-1">Return includes your stake.</p>
      <p class="text-xs text-[var(--text-3)] mt-2">
        Virtual play for enjoyment only — no real money is won or lost. For real-money betting, use a licensed bookmaker.
      </p>

      <div class="mt-4 flex gap-2">
        <button class="btn btn-secondary flex-1" id="slip-cancel" type="button">Cancel</button>
        <button class="btn btn-primary flex-1" id="slip-confirm" type="button">Confirm</button>
      </div>
      <div id="slip-msg" class="mt-2 text-center text-sm" aria-live="polite"></div>
    </div>
  </div>

  <script>
    import { API, getToken, authFetch, esc, money, toast, MARKET_LABEL, MARKET_SHORT, oddsText, payoutFor, fetchConfig } from '../lib/api';
    import { maybeAskPush } from '../lib/push';

    type BetConfig = { stake_tiers_cents: number[]; payout_multiplier_bp: number };

    let config: BetConfig = { stake_tiers_cents: [50000], payout_multiplier_bp: 15000 };
    let selectedStake = 0;
    let active: { id: string; market: string; teams: string; league: string; kickoff: string; confidence: string; oddsBp: number } | null = null;

    const slip = document.getElementById('slip')!;
    const slipMsg = document.getElementById('slip-msg')!;
    const confirmBtn = document.getElementById('slip-confirm') as HTMLButtonElement;
    const matchesEl = document.getElementById('matches')!;
    const previewNote = document.getElementById('previewNote');
    const slipMatch = document.getElementById('slip-match')!;
    const slipMarket = document.getElementById('slip-market')!;
    const slipOdds = document.getElementById('slip-odds')!;
    const slipConf = document.getElementById('slip-conf')!;
    const stakeTiersEl = document.getElementById('stake-tiers')!;
    const slipReturn = document.getElementById('slip-return')!;

    const statusMap: Record<string, { cls: string; label: string; dot?: boolean }> = {
      upcoming: { cls: 'badge-pending', label: 'PENDING' },
      live: { cls: 'badge-live', label: 'LIVE', dot: true },
      finished: { cls: 'badge-win', label: 'FINISHED' },
      postponed: { cls: 'badge-postponed', label: 'POSTPONED' },
      cancelled: { cls: 'badge-loss', label: 'CANCELLED' },
    };
    const confidenceMap: Record<string, string> = {
      high: 'badge-win',
      medium: 'badge-live',
      low: 'badge-pending',
    };

    async function loadConfig() {
      try {
        config = await fetchConfig();
      } catch {
        /* keep defaults */
      }
    }

    function renderTiers() {
      stakeTiersEl.innerHTML = config.stake_tiers_cents
        .map(
          (t) => `
          <button type="button" class="stake-chip ${t === selectedStake ? 'selected' : ''}" data-stake="${t}">
            ${money(t)}
          </button>`
        )
        .join('');
    }

    function updateReturn() {
      if (!selectedStake) {
        slipReturn.textContent = '—';
        return;
      }
      const bp = active?.oddsBp || config.payout_multiplier_bp;
      slipReturn.textContent = `${money(payoutFor(selectedStake, bp))} TZS`;
    }

    function openSlip(data: typeof active) {
      if (!getToken()) {
        window.location.href = '/login';
        return;
      }
      active = data;
      if (!data) return;
      selectedStake = config.stake_tiers_cents[Math.min(1, config.stake_tiers_cents.length - 1)] || config.stake_tiers_cents[0];
      slipMatch.textContent = `${data.teams} · ${data.league || 'Match'} · ${data.kickoff}`;
      slipMarket.textContent = MARKET_LABEL[data.market] || data.market;
      slipOdds.textContent = `${oddsText(data.oddsBp)}×`;
      slipConf.textContent = `${(data.confidence || 'medium').toUpperCase()} confidence`;
      slipConf.className = `badge ${confidenceMap[data.confidence] || confidenceMap.medium}`;
      slipMsg.textContent = '';
      slipMsg.className = 'mt-2 text-center text-sm';
      renderTiers();
      updateReturn();
      slip.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeSlip() {
      slip.classList.add('hidden');
      document.body.style.overflow = '';
      active = null;
    }

    slip.addEventListener('click', (e) => {
      if (e.target === slip) closeSlip();
    });
    document.getElementById('slip-cancel')!.addEventListener('click', closeSlip);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !slip.classList.contains('hidden')) closeSlip();
    });

    stakeTiersEl.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.stake-chip') as HTMLElement | null;
      if (!btn) return;
      selectedStake = Number(btn.dataset.stake);
      stakeTiersEl.querySelectorAll('.stake-chip').forEach((c) => c.classList.remove('selected'));
      btn.classList.add('selected');
      updateReturn();
    });

    confirmBtn.addEventListener('click', async () => {
      if (!active || !selectedStake) return;
      const placedId = active.id;
      const placedMarket = active.market;
      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Placing…';
      slipMsg.textContent = '';
      slipMsg.className = 'mt-2 text-center text-sm';
      try {
        const res = await authFetch('/api/v1/bets', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            match_id: placedId,
            market: placedMarket,
            stake_cents: selectedStake,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          slipMsg.textContent = data.error || 'Could not place the slip.';
          slipMsg.className = 'mt-2 text-center text-sm text-[var(--danger)]';
          return;
        }
        toast('Slip placed.');
        closeSlip();
        markPlaced(placedId, placedMarket);
        maybeAskPush();
      } catch {
        slipMsg.textContent = 'Network error. Try again.';
        slipMsg.className = 'mt-2 text-center text-sm text-[var(--danger)]';
      } finally {
        confirmBtn.disabled = false;
        confirmBtn.textContent = 'Confirm';
      }
    });

    function markPlaced(matchId: string, market: string) {
      const btn = document.querySelector(`button[data-match="${matchId}"][data-market="${market}"]`) as HTMLButtonElement | null;
      if (!btn) return;
      btn.disabled = true;
      btn.textContent = 'Placed';
    }

    let allMatches: any[] = [];
    let currentDay: 'today' | 'tomorrow' = 'today';

    // EAT (UTC+3, no DST) day keys as a fallback when the server has no rows.
    function eatDateKey(offsetDays: number): string {
      return new Date(Date.now() + 3 * 60 * 60 * 1000 + offsetDays * 24 * 60 * 60 * 1000)
        .toISOString()
        .slice(0, 10);
    }
    let dayKeys: Record<'today' | 'tomorrow', string> = { today: eatDateKey(0), tomorrow: eatDateKey(1) };

    function shortDate(key: string): string {
      try {
        return new Date(key + 'T12:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
      } catch {
        return key;
      }
    }

    function marketOutcome(m: any, mk: string): boolean | null {
      // Only settled matches with a final score have a real outcome.
      if (!m.settled || m.home_goals == null || m.away_goals == null) return null;
      if (mk === 'ft_over_0_5') return m.home_goals + m.away_goals >= 1;
      if (mk === 'ht_over_0_5') {
        if (m.home_goals_ht == null || m.away_goals_ht == null) return null;
        return m.home_goals_ht + m.away_goals_ht >= 1;
      }
      return null;
    }

    function cardHTML(m: any): string {
      const st = statusMap[m.status] || statusMap.upcoming;
      const conf = confidenceMap[m.confidence] || confidenceMap.medium;
      const markets = m.markets || [];
      const teams = `${m.home_team} vs ${m.away_team}`;

      const buttons = markets.length
        ? markets
            .map((mk: string) => {
              const odds = Number(m.market_odds?.[mk] || 0);
              const label = `${MARKET_SHORT[mk] || mk} <span class="mk-odds">${oddsText(odds)}×</span>`;
              if (m.settled) {
                const won = marketOutcome(m, mk);
                if (won === true) {
                  return `<button type="button" class="btn btn-secondary flex-1 text-sm" disabled>${label} <span class="mk-outcome mk-win" aria-label="won">✔</span></button>`;
                }
                if (won === false) {
                  return `<button type="button" class="btn btn-secondary flex-1 text-sm" disabled>${label} <span class="mk-outcome mk-loss" aria-label="lost">✘</span></button>`;
                }
                return `<button type="button" class="btn btn-secondary flex-1 text-sm" disabled>${label}</button>`;
              }
              if (!m.is_open) {
                return `<button type="button" class="btn btn-secondary flex-1 text-sm" disabled>${label} · closed</button>`;
              }
              return `<button type="button" class="btn btn-secondary flex-1 text-sm" data-match="${esc(m.id)}" data-market="${esc(mk)}" data-teams="${esc(teams)}" data-league="${esc(m.league || '')}" data-kickoff="${esc(m.match_date)} ${esc(m.kickoff)}" data-confidence="${esc(m.confidence || 'medium')}" data-odds="${odds}">${label}</button>`;
            })
            .join('')
        : '<span class="text-xs text-[var(--text-3)]">No markets open</span>';

      const scoreMid =
        m.settled && m.home_goals != null && m.away_goals != null
          ? `<div class="counter text-sm text-center whitespace-nowrap">${m.home_goals}–${m.away_goals}${
              m.home_goals_ht != null && m.away_goals_ht != null
                ? ` <span class="text-[var(--text-3)] text-xs font-normal">(HT ${m.home_goals_ht}–${m.away_goals_ht})</span>`
                : ''
            }</div>`
          : '<div class="text-[var(--text-3)] text-sm">vs</div>';

      return `
              <div class="card cv-auto">
                <div class="flex items-center justify-between mb-2 gap-2">
                  <span class="text-xs text-[var(--text-3)] leading-snug break-words">
                    ${esc(m.league || '')}${m.league ? ' · ' : ''}${esc(m.match_date)} ${esc(m.kickoff)}
                  </span>
                  <span class="badge ${conf} shrink-0">${esc((m.confidence || 'medium').toUpperCase())}</span>
                </div>
                <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3">
                  <div class="font-semibold leading-tight break-words">${esc(m.home_team)}</div>
                  ${scoreMid}
                  <div class="font-semibold leading-tight break-words text-right">${esc(m.away_team)}</div>
                </div>
                <div class="mt-2 flex items-center justify-between gap-2">
                  <span class="badge ${st.cls}">${st.dot ? '<span class="dot"></span> ' : ''}${st.label}</span>
                  <span class="text-xs text-[var(--text-3)]">${m.is_open ? 'Open for betting' : 'Betting closed'}</span>
                </div>
                <div class="mt-3 flex gap-2">${buttons}</div>
              </div>`;
    }

    function matchesFor(day: 'today' | 'tomorrow'): any[] {
      const key = dayKeys[day];
      return allMatches.filter((m: any) => m.match_date === key);
    }

    function renderDay() {
      const list = matchesFor(currentDay);
      if (!list.length) {
        matchesEl.innerHTML = `<div class="card empty-state">No matches ${currentDay === 'today' ? 'today' : 'tomorrow'} yet.</div>`;
        return;
      }
      matchesEl.innerHTML = list.map(cardHTML).join('');
    }

    function setDay(day: 'today' | 'tomorrow') {
      currentDay = day;
      document.querySelectorAll<HTMLButtonElement>('.day-tab').forEach((tab) => {
        const on = tab.dataset.day === day;
        tab.classList.toggle('active', on);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      renderDay();
    }

    async function load() {
      try {
        // Send the token when signed in so an inactive account receives only
        // the three-match preview instead of the full published list.
        const token = getToken();
        const res = token
          ? await authFetch('/api/v1/matches')
          : await fetch(`${API}/api/v1/matches`);
        const data = await res.json().catch(() => ({}));
        allMatches = data.matches || [];
        previewNote?.classList.toggle('hidden', !data.preview);

        // The API only publishes the two days Home cares about. Keep the
        // device-computed EAT dates as the tab labels; when only one day has
        // matches, place it on the correct tab instead of showing it twice.
        const dates = [...new Set(allMatches.map((m: any) => String(m.match_date)))].sort();
        const eatToday = eatDateKey(0);
        const eatTomorrow = eatDateKey(1);
        if (dates.length >= 2) {
          dayKeys.today = dates[0];
          dayKeys.tomorrow = dates[1];
        } else if (dates.length === 1) {
          const only = dates[0];
          dayKeys.today = eatToday;
          dayKeys.tomorrow = eatTomorrow;
          if (only === eatTomorrow) {
            dayKeys.tomorrow = only;
          } else {
            dayKeys.today = only;
          }
        }

        for (const day of ['today', 'tomorrow'] as const) {
          const n = matchesFor(day).length;
          const sub = document.getElementById(`tab-${day}-sub`);
          if (sub) {
            sub.textContent = `${shortDate(dayKeys[day])}${n ? ` · ${n} match${n === 1 ? '' : 'es'}` : ''}`;
          }
        }

        if (!allMatches.length) {
          matchesEl.innerHTML =
            '<div class="card empty-state">No matches yet.</div>';
          return;
        }

        // If today has nothing but tomorrow does, land the user on tomorrow.
        if (currentDay === 'today' && !matchesFor('today').length && matchesFor('tomorrow').length) {
          setDay('tomorrow');
        } else {
          renderDay();
        }
      } catch {
        matchesEl.innerHTML =
          '<div class="card empty-state"><p>Could not load matches. Check your connection.</p><button type="button" class="btn btn-secondary text-sm" id="retryMatches">Retry</button></div>';
        document.getElementById('retryMatches')?.addEventListener('click', () => { void load(); }, { once: true });
      }
    }

    matchesEl.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-market]') as HTMLButtonElement | null;
      if (!btn || btn.disabled) return;
      openSlip({
        id: btn.dataset.match!,
        market: btn.dataset.market!,
        teams: btn.dataset.teams!,
        league: btn.dataset.league!,
        kickoff: btn.dataset.kickoff!,
        confidence: btn.dataset.confidence!,
        oddsBp: Number(btn.dataset.odds) || 0,
      });
    });

    document.getElementById('day-tabs')!.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.day-tab') as HTMLElement | null;
      if (!btn) return;
      const day = btn.dataset.day as 'today' | 'tomorrow' | undefined;
      if (day && day !== currentDay) setDay(day);
    });

    (async () => {
      await Promise.all([loadConfig(), load()]);
    })();
  </script>

  <style>
    .slip-overlay {
      position: fixed;
      inset: 0;
      z-index: 120;
      background: rgba(17, 24, 39, 0.35);
      backdrop-filter: blur(2px);
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: env(safe-area-inset-top) 0 0;
    }
    .slip-overlay.hidden { display: none; }
    .slip-sheet {
      width: 100%;
      max-width: 480px;
      max-height: calc(100dvh - env(safe-area-inset-top) - var(--s2));
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior: contain;
      background: var(--surface, #ffffff);
      border: 1px solid var(--border);
      border-bottom: none;
      border-radius: var(--r-xl) var(--r-xl) 0 0;
      padding: var(--s3) var(--s5) calc(var(--s6) + 88px + env(safe-area-inset-bottom));
      box-shadow: 0 -12px 32px rgba(17, 24, 39, 0.12);
      animation: sheetUp 220ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    @keyframes sheetUp {
      from { transform: translateY(24px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    /* From 640px the sheet becomes a centred dialog: a full-width bottom
       sheet on a large screen reads like a bug, not a choice. */
    @media (min-width: 640px) {
      .slip-overlay {
        align-items: center;
        padding: var(--s4);
      }
      .slip-sheet {
        border-radius: var(--r-xl);
        border-bottom: 1px solid var(--border);
        padding: var(--s4) var(--s5) var(--s5);
        max-height: calc(100dvh - 2 * var(--s4));
      }
      .slip-grip { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .slip-sheet { animation: none; }
    }
    .slip-grip {
      width: 40px;
      height: 4px;
      border-radius: 999px;
      background: var(--border);
      margin: 0 auto 12px;
    }

    /* Today / Tomorrow segmented control — 4-grid: 4px padding, 4px gap,
       16px container radius, 12px inner buttons, 44px targets. */
    .day-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--s1);
      padding: var(--s1);
      border-radius: var(--r-lg);
      background: var(--surface-el);
      border: 1px solid var(--border);
    }
    .day-tab {
      min-height: var(--tap);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      border-radius: var(--r-md);
      padding: var(--s1) var(--s2);
      color: var(--text-2);
      cursor: pointer;
      touch-action: manipulation;
      transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
      -webkit-tap-highlight-color: transparent;
    }
    .day-tab:hover {
      color: var(--text);
    }
    .day-tab.active {
      background: linear-gradient(135deg, var(--brand), var(--brand-2));
      color: #fff;
      box-shadow: 0 2px 12px var(--brand-glow);
    }
    .day-tab:focus-visible {
      outline: 2px solid var(--brand);
      outline-offset: 2px;
    }
    .dt-label {
      font-weight: 700;
      font-size: 0.95rem;
      line-height: 1.1;
    }
    .dt-sub {
      font-size: 0.7rem;
      line-height: 1.2;
      opacity: 0.85;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }

    /* Odds sit inside the market button without growing its width. */
    .mk-odds {
      font-size: 11px;
      opacity: 0.75;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    /* Win / lost tick and cross on settled market buttons */
    .mk-outcome {
      font-weight: 700;
      margin-left: 2px;
    }
    .mk-win {
      color: #4ade80;
    }
    .mk-loss {
      color: #f87171;
    }
  </style>
</Layout>
