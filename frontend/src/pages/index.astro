---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Betva — Home" description="Today’s and tomorrow’s football matches. Fixed stakes, fast settlement, honest records." active="home">
  <div class="px-4 pt-4 space-y-4">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold">Betva</h1>
      <a href="/profile" class="tap-link text-sm text-[var(--text-2)]">Profile</a>
    </div>

    <!-- Trust counter -->
    <div class="glass p-4">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm text-[var(--text-2)]">Track record</span>
        <span class="badge badge-pending" id="counter-status">No settled results yet</span>
      </div>
      <div class="grid grid-cols-3 gap-3 text-center">
        <div>
          <div class="text-2xl font-bold counter" id="c-total">—</div>
          <div class="text-xs text-[var(--text-3)]">Matches</div>
        </div>
        <div>
          <div class="text-2xl font-bold counter text-green-400" id="c-wins">—</div>
          <div class="text-xs text-[var(--text-3)]">Wins</div>
        </div>
        <div>
          <div class="text-2xl font-bold counter" id="c-rate">—</div>
          <div class="text-xs text-[var(--text-3)]">Win rate</div>
        </div>
      </div>
    </div>

    <!-- Matches -->
    <div>
      <h2 class="text-lg font-semibold mb-3">Today &amp; Tomorrow</h2>
      <div id="matches" class="space-y-3">
        <div class="card"><div class="skeleton h-24"></div></div>
        <div class="card"><div class="skeleton h-24"></div></div>
        <div class="card"><div class="skeleton h-24"></div></div>
      </div>
    </div>
  </div>

  <!-- Bet slip -->
  <div id="slip" class="slip-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="slip-title">
    <div class="slip-sheet">
      <div class="slip-grip"></div>
      <h2 id="slip-title" class="text-lg font-bold">Place slip</h2>
      <div id="slip-match" class="text-sm text-[var(--text-2)] mt-1"></div>

      <div class="mt-3 flex items-center gap-2">
        <span class="badge badge-pending" id="slip-market">—</span>
        <span class="badge badge-pending" id="slip-conf">—</span>
      </div>

      <div class="mt-4">
        <div class="text-sm text-[var(--text-2)] mb-2">Stake</div>
        <div id="stake-tiers" class="grid grid-cols-4 gap-2"></div>
      </div>

      <div class="mt-4 flex items-center justify-between text-sm">
        <span class="text-[var(--text-2)]">Potential return</span>
        <span class="counter text-lg" id="slip-return">—</span>
      </div>
      <p class="text-xs text-[var(--text-3)] mt-1">Return includes your stake.</p>

      <div class="mt-4 flex gap-2">
        <button class="btn btn-secondary flex-1" id="slip-cancel" type="button">Cancel</button>
        <button class="btn btn-primary flex-1" id="slip-confirm" type="button">Confirm</button>
      </div>
      <div id="slip-msg" class="mt-2 text-center text-sm" aria-live="polite"></div>
    </div>
  </div>

  <script>
    import { API, getToken, authFetch, esc, money, toast, MARKET_LABEL } from '../lib/api';
    import { maybeAskPush } from '../lib/push';

    type BetConfig = { stake_tiers_cents: number[]; payout_multiplier_bp: number };

    let config: BetConfig = { stake_tiers_cents: [50000], payout_multiplier_bp: 15000 };
    let selectedStake = 0;
    let active: { id: string; market: string; teams: string; league: string; kickoff: string; confidence: string } | null = null;

    const slip = document.getElementById('slip')!;
    const slipMsg = document.getElementById('slip-msg')!;
    const confirmBtn = document.getElementById('slip-confirm') as HTMLButtonElement;

    const statusMap: Record<string, { cls: string; label: string; dot?: boolean }> = {
      upcoming: { cls: 'badge-pending', label: 'PENDING' },
      live: { cls: 'badge-live', label: 'LIVE', dot: true },
      finished: { cls: 'badge-win', label: 'FINISHED' },
      postponed: { cls: 'badge-postponed', label: 'POSTPONED' },
      cancelled: { cls: 'badge-loss', label: 'CANCELLED' },
    };
    const confidenceMap: Record<string, string> = {
      high: 'badge-win',
      medium: 'badge-live',
      low: 'badge-pending',
    };

    async function loadConfig() {
      try {
        const res = await fetch(`${API}/api/v1/config`);
        config = await res.json();
      } catch {
        /* keep defaults */
      }
    }

    function renderTiers() {
      const el = document.getElementById('stake-tiers')!;
      el.innerHTML = config.stake_tiers_cents
        .map(
          (t) => `
          <button type="button" class="stake-chip ${t === selectedStake ? 'selected' : ''}" data-stake="${t}">
            ${money(t)}
          </button>`
        )
        .join('');
    }

    function updateReturn() {
      const el = document.getElementById('slip-return')!;
      if (!selectedStake) {
        el.textContent = '—';
        return;
      }
      const ret = Math.floor((selectedStake * config.payout_multiplier_bp) / 10000);
      el.textContent = `${money(ret)} TZS`;
    }

    function openSlip(data: typeof active) {
      if (!getToken()) {
        window.location.href = '/login';
        return;
      }
      active = data;
      if (!data) return;
      selectedStake = config.stake_tiers_cents[Math.min(1, config.stake_tiers_cents.length - 1)] || config.stake_tiers_cents[0];
      document.getElementById('slip-match')!.textContent = `${data.teams} · ${data.league || 'Match'} · ${data.kickoff}`;
      document.getElementById('slip-market')!.textContent = MARKET_LABEL[data.market] || data.market;
      const conf = document.getElementById('slip-conf')!;
      conf.textContent = `${(data.confidence || 'medium').toUpperCase()} confidence`;
      conf.className = `badge ${confidenceMap[data.confidence] || confidenceMap.medium}`;
      slipMsg.textContent = '';
      slipMsg.className = 'mt-2 text-center text-sm';
      renderTiers();
      updateReturn();
      slip.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeSlip() {
      slip.classList.add('hidden');
      document.body.style.overflow = '';
      active = null;
    }

    slip.addEventListener('click', (e) => {
      if (e.target === slip) closeSlip();
    });
    document.getElementById('slip-cancel')!.addEventListener('click', closeSlip);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !slip.classList.contains('hidden')) closeSlip();
    });

    document.getElementById('stake-tiers')!.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.stake-chip') as HTMLElement | null;
      if (!btn) return;
      selectedStake = Number(btn.dataset.stake);
      document.querySelectorAll('.stake-chip').forEach((c) => c.classList.remove('selected'));
      btn.classList.add('selected');
      updateReturn();
    });

    confirmBtn.addEventListener('click', async () => {
      if (!active || !selectedStake) return;
      const placedId = active.id;
      const placedMarket = active.market;
      confirmBtn.disabled = true;
      confirmBtn.textContent = 'Placing…';
      slipMsg.textContent = '';
      slipMsg.className = 'mt-2 text-center text-sm';
      try {
        const res = await authFetch('/api/v1/bets', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            match_id: placedId,
            market: placedMarket,
            stake_cents: selectedStake,
          }),
        });
        const data = await res.json();
        if (!res.ok) {
          slipMsg.textContent = data.error || 'Could not place the slip.';
          slipMsg.className = 'mt-2 text-center text-sm text-red-400';
          return;
        }
        toast(`Slip placed. Balance ${money(data.balance_cents)} TZS`);
        closeSlip();
        markPlaced(placedId, placedMarket);
        maybeAskPush();
      } catch {
        slipMsg.textContent = 'Network error. Try again.';
        slipMsg.className = 'mt-2 text-center text-sm text-red-400';
      } finally {
        confirmBtn.disabled = false;
        confirmBtn.textContent = 'Confirm';
      }
    });

    function markPlaced(matchId: string, market: string) {
      const btn = document.querySelector(`button[data-match="${matchId}"][data-market="${market}"]`) as HTMLButtonElement | null;
      if (!btn) return;
      btn.disabled = true;
      btn.textContent = 'Placed';
    }

    async function load() {
      const el = document.getElementById('matches')!;
      try {
        const res = await fetch(`${API}/api/v1/matches`);
        const data = await res.json();
        const matches = data.matches || [];

        if (!matches.length) {
          el.innerHTML =
            '<div class="card text-center text-[var(--text-2)]">No matches published right now. Check back later today.</div>';
          return;
        }

        el.innerHTML = matches
          .map((m: any) => {
            const st = statusMap[m.status] || statusMap.upcoming;
            const conf = confidenceMap[m.confidence] || confidenceMap.medium;
            const markets = m.markets || [];
            const teams = `${m.home_team} vs ${m.away_team}`;

            const buttons = markets.length
              ? markets
                  .map((mk: string) => {
                    const label = MARKET_LABEL[mk] || mk;
                    if (!m.is_open) {
                      return `<button class="btn btn-secondary flex-1 text-sm" disabled>${esc(label)} · closed</button>`;
                    }
                    return `<button class="btn btn-secondary flex-1 text-sm" data-match="${esc(m.id)}" data-market="${esc(mk)}" data-teams="${esc(teams)}" data-league="${esc(m.league || '')}" data-kickoff="${esc(m.match_date)} ${esc(m.kickoff)}" data-confidence="${esc(m.confidence || 'medium')}">${esc(label)}</button>`;
                  })
                  .join('')
              : '<span class="text-xs text-[var(--text-3)]">No markets open</span>';

            return `
              <div class="card">
                <div class="flex items-center justify-between mb-2 gap-2">
                  <span class="text-xs text-[var(--text-3)] truncate">
                    ${esc(m.league || '')}${m.league ? ' · ' : ''}${esc(m.match_date)} ${esc(m.kickoff)}
                  </span>
                  <span class="badge ${conf}">${esc((m.confidence || 'medium').toUpperCase())}</span>
                </div>
                <div class="flex items-center justify-between gap-3">
                  <div class="font-semibold truncate">${esc(m.home_team)}</div>
                  <div class="text-[var(--text-3)] text-sm shrink-0">vs</div>
                  <div class="font-semibold truncate text-right">${esc(m.away_team)}</div>
                </div>
                <div class="mt-2 flex items-center justify-between gap-2">
                  <span class="badge ${st.cls}">${st.dot ? '<span class="dot"></span> ' : ''}${st.label}</span>
                  <span class="text-xs text-[var(--text-3)]">${m.is_open ? 'Open for betting' : 'Betting closed'}</span>
                </div>
                <div class="mt-3 flex gap-2">${buttons}</div>
              </div>`;
          })
          .join('');
      } catch {
        el.innerHTML =
          '<div class="card text-center text-[var(--text-2)]">Could not load matches. Check your connection and try again.</div>';
      }
    }

    document.getElementById('matches')!.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button[data-market]') as HTMLButtonElement | null;
      if (!btn || btn.disabled) return;
      openSlip({
        id: btn.dataset.match!,
        market: btn.dataset.market!,
        teams: btn.dataset.teams!,
        league: btn.dataset.league!,
        kickoff: btn.dataset.kickoff!,
        confidence: btn.dataset.confidence!,
      });
    });

    (async () => {
      await loadConfig();
      await load();
    })();
  </script>

  <style>
    .slip-overlay {
      position: fixed;
      inset: 0;
      z-index: 90;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(2px);
      display: flex;
      align-items: flex-end;
      justify-content: center;
    }
    .slip-overlay.hidden { display: none; }
    .slip-sheet {
      width: 100%;
      max-width: 480px;
      background: #10161d;
      border: 1px solid var(--border);
      border-bottom: none;
      border-radius: 20px 20px 0 0;
      padding: 12px 20px calc(20px + env(safe-area-inset-bottom));
      box-shadow: 0 -12px 48px rgba(0, 0, 0, 0.5);
      animation: sheetUp 220ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    @keyframes sheetUp {
      from { transform: translateY(24px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
      .slip-sheet { animation: none; }
    }
    .slip-grip {
      width: 40px;
      height: 4px;
      border-radius: 999px;
      background: var(--border);
      margin: 0 auto 12px;
    }
  </style>
</Layout>
