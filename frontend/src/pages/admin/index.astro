---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Betva Admin — Overview" active="overview">
  <div class="space-y-5">
    <div>
      <h1 class="text-2xl font-bold">Overview</h1>
      <p class="text-sm text-[var(--text-2)]">Today at a glance.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="card">
        <div class="text-xs text-[var(--text-3)]">Today</div>
        <div class="text-2xl font-bold counter" id="stat-today">—</div>
        <div class="text-xs text-[var(--text-3)]">matches published</div>
      </div>
      <div class="card">
        <div class="text-xs text-[var(--text-3)]">Tomorrow</div>
        <div class="text-2xl font-bold counter" id="stat-tomorrow">—</div>
        <div class="text-xs text-[var(--text-3)]">matches queued</div>
      </div>
      <div class="card">
        <div class="text-xs text-[var(--text-3)]">Users</div>
        <div class="text-2xl font-bold counter" id="stat-users">—</div>
        <div class="text-xs text-[var(--text-3)]">total registered</div>
      </div>
      <div class="card">
        <div class="text-xs text-[var(--text-3)]">Active</div>
        <div class="text-2xl font-bold counter text-green-400" id="stat-active">—</div>
        <div class="text-xs text-[var(--text-3)]">paid accounts</div>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-3">
      <a href="/admin/matches" class="card block hover:border-[var(--brand)] transition-colors">
        <h2 class="font-semibold mb-1">Matches</h2>
        <p class="text-sm text-[var(--text-2)]">Upload a CSV for a date, review the day's fixtures, adjust confidence.</p>
      </a>
      <a href="/admin/users" class="card block hover:border-[var(--brand)] transition-colors">
        <h2 class="font-semibold mb-1">Users &amp; financial status</h2>
        <p class="text-sm text-[var(--text-2)]">Search users, confirm mobile money payments, activate or suspend accounts.</p>
      </a>
      <a href="/admin/community" class="card block hover:border-[var(--brand)] transition-colors">
        <h2 class="font-semibold mb-1">Community moderation</h2>
        <p class="text-sm text-[var(--text-2)]">Review reported posts, hide or restore content, keep the record of who acted.</p>
      </a>
      <a href="/admin/notifications" class="card block hover:border-[var(--brand)] transition-colors">
        <h2 class="font-semibold mb-1">Notifications</h2>
        <p class="text-sm text-[var(--text-2)]">Send a short announcement. Caps, quiet hours and mutes apply automatically.</p>
      </a>
      <a href="/admin/ai" class="card block hover:border-[var(--brand)] transition-colors">
        <h2 class="font-semibold mb-1">AI result suggestions</h2>
        <p class="text-sm text-[var(--text-2)]">Groq proposes a score from a result page. Review and approve before settling — the AI never settles.</p>
      </a>
    </div>

    <div class="card">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold">Recent imports</h2>
        <a href="/admin/matches" class="tap-link text-sm text-[var(--brand)]">Open matches</a>
      </div>
      <div id="imports" class="text-sm text-[var(--text-2)]">Loading…</div>
    </div>
  </div>

  <script>
    import { adminFetch, requireAdmin, todayISO, esc } from '../../lib/admin';

    if (requireAdmin()) load();

    async function load() {
      const today = todayISO();
      const tomorrow = new Date(new Date(today).getTime() + 86400000).toISOString().slice(0, 10);

      try {
        const [todayRes, tomorrowRes, usersRes, importsRes] = await Promise.all([
          adminFetch(`/api/v1/admin/matches?date=${today}`),
          adminFetch(`/api/v1/admin/matches?date=${tomorrow}`),
          adminFetch('/api/v1/admin/users?limit=1'),
          adminFetch('/api/v1/admin/imports?limit=5'),
        ]);

        const todayData = await todayRes.json().catch(() => ({}));
        const tomorrowData = await tomorrowRes.json().catch(() => ({}));
        const usersData = await usersRes.json().catch(() => ({}));
        const importsData = await importsRes.json().catch(() => ({}));

        setText('stat-today', String(todayData.matches?.length ?? 0));
        setText('stat-tomorrow', String(tomorrowData.matches?.length ?? 0));
        setText('stat-users', String(usersData.total ?? 0));

        const activeRes = await adminFetch('/api/v1/admin/users?status=active&limit=1');
        const activeData = await activeRes.json().catch(() => ({}));
        setText('stat-active', String(activeData.total ?? 0));

        const el = document.getElementById('imports')!;
        const imports = importsData.imports || [];
        if (!imports.length) {
          el.textContent = 'No imports yet.';
        } else {
          el.innerHTML = imports
            .map(
              (i: any) => `
              <div class="flex items-center justify-between gap-3 py-2 border-b border-[var(--border)] last:border-0">
                <div>
                  <div class="text-[var(--text)] font-medium">${esc(i.match_date)}</div>
                  <div class="text-xs text-[var(--text-3)]">${esc(i.file_name || 'upload')} · ${esc(i.created_at)}</div>
                </div>
                <div class="text-right text-xs">
                  <div class="text-green-400">${i.rows_imported} imported</div>
                  ${i.rows_failed ? `<div class="text-red-400">${i.rows_failed} failed</div>` : ''}
                </div>
              </div>`
            )
            .join('');
        }
      } catch {
        /* adminFetch redirects on auth failure */
      }
    }

    function setText(id: string, v: string) {
      const el = document.getElementById(id);
      if (el) el.textContent = v;
    }
  </script>
</AdminLayout>
