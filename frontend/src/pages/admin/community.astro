---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Betva Admin — Community" active="community">
  <div class="space-y-5">
    <div>
      <h1 class="text-2xl font-bold">Community moderation</h1>
      <p class="text-sm text-[var(--text-2)]">
        Three reports auto-hide a post. Every action is logged.
      </p>
    </div>

    <section class="card space-y-3">
      <div>
        <h2 class="font-semibold">Publish a YouTube video</h2>
        <p class="text-xs text-[var(--text-3)]">
          Posts the video to the community feed as an embedded player. Views and subscribers count on YouTube — nothing is uploaded here.
        </p>
      </div>
      <label class="text-sm text-[var(--text-2)] block" for="ytBody">Caption (optional)</label>
      <textarea id="ytBody" class="input" rows="2" maxlength="500" placeholder="What is this video about?"></textarea>
      <label class="text-sm text-[var(--text-2)] block" for="ytUrl">YouTube URL</label>
      <input id="ytUrl" class="input" type="url" inputmode="url" placeholder="https://youtu.be/…" autocomplete="off" />
      <div class="flex items-center justify-between gap-2">
        <div id="ytMsg" class="text-sm" aria-live="polite"></div>
        <button class="btn btn-primary text-sm shrink-0" id="ytPublish" type="button">Publish video</button>
      </div>
    </section>

    <section class="card space-y-3">
      <div class="flex items-center justify-between gap-3 flex-wrap">
        <div class="admin-filters" id="filters">
          <button class="btn btn-secondary text-sm filter active" data-status="reported" type="button">Reported</button>
          <button class="btn btn-secondary text-sm filter" data-status="visible" type="button">Visible</button>
          <button class="btn btn-secondary text-sm filter" data-status="hidden" type="button">Hidden</button>
          <button class="btn btn-secondary text-sm filter" data-status="deleted" type="button">Deleted</button>
          <button class="btn btn-secondary text-sm filter" data-status="" type="button">All</button>
        </div>
        <button class="btn btn-secondary text-sm" id="refresh" type="button">Refresh</button>
      </div>
      <div id="list" class="text-sm text-[var(--text-2)]">
        <div class="space-y-2 py-1" aria-hidden="true">
          <div class="skeleton h-14 w-full"></div>
          <div class="skeleton h-14 w-full"></div>
          <div class="skeleton h-14 w-4/5"></div>
        </div>
      </div>
    </section>
  </div>

  <script>
    import { adminFetch, requireAdmin, esc, statusBadge, API } from '../../lib/admin';

    let currentStatus = 'reported';

    if (requireAdmin()) load();

    document.querySelectorAll<HTMLButtonElement>('.filter').forEach((btn) => {
      btn.addEventListener('click', () => {
        currentStatus = btn.dataset.status || '';
        document.querySelectorAll('.filter').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        load();
      });
    });
    document.getElementById('refresh')!.addEventListener('click', load);

    // Publish a YouTube video: the backend extracts and stores only the
    // 11-character video ID; the feed renders YouTube's iframe player.
    document.getElementById('ytPublish')!.addEventListener('click', async () => {
      const btn = document.getElementById('ytPublish') as HTMLButtonElement;
      const msg = document.getElementById('ytMsg')!;
      const url = (document.getElementById('ytUrl') as HTMLInputElement).value.trim();
      const body = (document.getElementById('ytBody') as HTMLTextAreaElement).value.trim();
      if (!url) {
        msg.textContent = 'Paste a YouTube URL first.';
        msg.className = 'text-sm text-[var(--danger)]';
        return;
      }
      btn.disabled = true;
      msg.textContent = 'Publishing…';
      msg.className = 'text-sm text-[var(--text-2)]';
      try {
        const res = await adminFetch('/api/v1/admin/community/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ body, youtube_url: url }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          msg.textContent = data.error || 'Could not publish.';
          msg.className = 'text-sm text-[var(--danger)]';
          return;
        }
        (document.getElementById('ytUrl') as HTMLInputElement).value = '';
        (document.getElementById('ytBody') as HTMLTextAreaElement).value = '';
        msg.textContent = 'Published to the feed.';
        msg.className = 'text-sm text-[var(--success)]';
        currentStatus = 'visible';
        document.querySelectorAll<HTMLButtonElement>('.filter').forEach((b) => b.classList.toggle('active', b.dataset.status === 'visible'));
        await load();
      } catch {
        msg.textContent = 'Network error. Try again.';
        msg.className = 'text-sm text-[var(--danger)]';
      } finally {
        btn.disabled = false;
      }
    });

    function renderRowsChunked<T>(tbody: HTMLTableSectionElement, items: T[], render: (item: T) => string, size = 20) {
      let i = 0;
      const step = () => {
        const end = Math.min(i + size, items.length);
        let html = '';
        for (; i < end; i++) html += render(items[i]);
        if (html) tbody.insertAdjacentHTML('beforeend', html);
        if (i < items.length) requestAnimationFrame(step);
      };
      step();
    }

    async function load() {
      const el = document.getElementById('list')!;
      el.innerHTML = '<div class="space-y-2 py-1" aria-hidden="true"><div class="skeleton h-14 w-full"></div><div class="skeleton h-14 w-full"></div><div class="skeleton h-14 w-4/5"></div></div>';
      try {
        const res = await adminFetch(`/api/v1/admin/community/posts?status=${encodeURIComponent(currentStatus)}`);
        const data = await res.json().catch(() => ({}));
        const posts = data.posts || [];
        if (!posts.length) {
          el.innerHTML = '<div class="text-[var(--text-3)]">Nothing in this queue.</div>';
          return;
        }

        el.innerHTML = `
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr><th>When</th><th>Author</th><th>Post</th><th>Reports</th><th>Status</th><th>Moderate</th></tr>
              </thead>
              <tbody id="queueBody"></tbody>
            </table>
          </div>`;
        const tbody = document.getElementById('queueBody') as HTMLTableSectionElement | null;
        if (tbody) {
          renderRowsChunked(tbody, posts, (p: any) => `
                  <tr data-id="${esc(p.id)}">
                    <td class="text-xs text-[var(--text-3)] whitespace-nowrap">${esc(p.created_at)}</td>
                    <td>
                      <div class="font-medium">${esc(p.nickname)}</div>
                      <div class="text-xs text-[var(--text-3)]">${esc(p.phone)}</div>
                    </td>
                    <td class="max-w-[320px]">
                      <div class="text-[var(--text)] whitespace-pre-wrap break-words">${esc(p.body || '(media only)')}</div>
                      ${
                        p.media_type === 'youtube' && p.youtube_id
                          ? `<a class="text-xs text-[var(--brand)]" href="https://www.youtube.com/watch?v=${esc(p.youtube_id)}" target="_blank" rel="noopener">youtube video</a>`
                          : p.media_url
                            ? `<a class="text-xs text-[var(--brand)]" href="${esc(p.media_url.startsWith('http') ? p.media_url : API + p.media_url)}" target="_blank" rel="noopener">${esc(p.media_type)} attachment</a>`
                            : ''
                      }
                      ${p.moderation_reason ? `<div class="text-xs text-[var(--text-3)] mt-1">Reason: ${esc(p.moderation_reason)}</div>` : ''}
                    </td>
                    <td class="counter">
                      ${p.open_reports}
                      <span class="text-xs text-[var(--text-3)]">open / ${p.report_count} total</span>
                    </td>
                    <td><span class="badge ${statusBadge(p.status === 'visible' ? 'active' : p.status === 'hidden' ? 'upcoming' : 'banned')}">${esc(p.status.toUpperCase())}</span></td>
                    <td>
                      <input class="input admin-reason mb-1" data-reason placeholder="Reason (required)" />
                      <div class="admin-actions">
                        <button class="btn btn-secondary text-xs mod" data-action="hidden" type="button">Hide</button>
                        <button class="btn btn-secondary text-xs mod" data-action="visible" type="button">Restore</button>
                        <button class="btn btn-danger text-xs mod" data-action="deleted" type="button">Delete</button>
                      </div>
                    </td>
                  </tr>`);
        }
      } catch {
        el.innerHTML = '<div class="text-center text-[var(--text-2)] space-y-3 py-2"><p>Could not load the moderation queue.</p><button type="button" class="btn btn-secondary text-sm" id="retryQueue">Retry</button></div>';
        document.getElementById('retryQueue')?.addEventListener('click', () => { void load(); }, { once: true });
      }
    }

    document.getElementById('list')!.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('.mod') as HTMLButtonElement | null;
      if (!btn) return;
      const row = btn.closest('tr')!;
      const id = row.dataset.id!;
      const status = btn.dataset.action!;
      const reason = (row.querySelector('[data-reason]') as HTMLInputElement).value.trim();

      if (status !== 'visible' && !reason) {
        alert('Add a reason before hiding or deleting.');
        return;
      }
      if (status === 'deleted' && !confirm('Delete this post from the feed? The record stays in the database.')) return;

      btn.disabled = true;
      try {
        const res = await adminFetch(`/api/v1/admin/community/posts/${id}/status`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status, reason }),
        });
        if (!res.ok) {
          alert('Could not update the post.');
          btn.disabled = false;
          return;
        }
        await load();
      } catch {
        alert('Could not update the post. Check your connection.');
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</AdminLayout>
