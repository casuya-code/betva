---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Betva Admin - AI Results" active="ai">
  <div class="space-y-5">
    <div>
      <h1 class="text-2xl font-bold">AI result suggestions</h1>
      <p class="text-sm text-[var(--text-2)]">
        AI proposes a score. It <strong>never</strong> settles — review, then use the normal settle flow.
      </p>
    </div>

    <div class="glass-el p-3 text-sm text-[var(--text-2)]">
      <strong class="text-[var(--text)]">Guardrails:</strong>
      Goals 0–30; half-time optional; admin decides confidence; nothing is written to the ledger.
    </div>

    <section class="card space-y-4">
      <h2 class="font-semibold">Generate a suggestion</h2>
      <div class="grid gap-3 md:grid-cols-[160px_1fr_auto] items-end">
        <div>
          <label class="text-sm text-[var(--text-2)] mb-1 block" for="matchDate">Match date</label>
          <input class="input" id="matchDate" type="date" />
        </div>
        <div>
          <label class="text-sm text-[var(--text-2)] mb-1 block" for="matchSelect">Match</label>
          <select class="input" id="matchSelect"></select>
        </div>
        <button class="btn btn-secondary" id="loadMatches" type="button">Load matches</button>
      </div>
      <div>
        <label class="text-sm text-[var(--text-2)] mb-1 block" for="sourceUrl">Result page URL</label>
        <input class="input" id="sourceUrl" type="url" placeholder="https://-/match-result" />
      </div>
      <div class="flex items-center gap-3 flex-wrap">
        <button class="btn btn-primary" id="generate" type="button">Generate suggestion</button>
        <span class="text-xs text-[var(--text-3)]">Requires <code>GROQ_API_KEY</code> on the server.</span>
      </div>
      <div id="genMsg" class="text-sm" aria-live="polite"></div>
    </section>

    <section class="card space-y-3">
      <div class="flex items-center justify-between gap-3 flex-wrap">
        <h2 class="font-semibold">Suggestions</h2>
        <div class="flex items-center gap-2">
          <select class="input w-auto min-w-[120px]" id="filterStatus">
            <option value="">All</option>
            <option value="pending" selected>Pending</option>
            <option value="approved">Approved</option>
            <option value="rejected">Rejected</option>
            <option value="failed">Failed</option>
          </select>
          <button class="btn btn-secondary text-sm" id="refresh" type="button">Refresh</button>
        </div>
      </div>
      <div id="list" class="text-sm text-[var(--text-2)]">Loading…</div>
    </section>
  </div>

  <script>
    import { adminFetch, requireAdmin, esc, oddsBadge } from '../../lib/admin';

    if (!requireAdmin()) throw new Error('not admin');

    const matchDate = document.getElementById('matchDate') as HTMLInputElement;
    const matchSelect = document.getElementById('matchSelect') as HTMLSelectElement;
    const sourceUrl = document.getElementById('sourceUrl') as HTMLInputElement;
    const genMsg = document.getElementById('genMsg')!;

    matchDate.value = new Date().toISOString().slice(0, 10);

    document.getElementById('loadMatches')!.addEventListener('click', loadMatches);
    document.getElementById('generate')!.addEventListener('click', generate);
    document.getElementById('refresh')!.addEventListener('click', loadList);
    document.getElementById('filterStatus')!.addEventListener('change', loadList);

    async function loadMatches() {
      const date = matchDate.value;
      if (!date) return;
      try {
        const res = await adminFetch(`/api/v1/admin/matches?date=${encodeURIComponent(date)}`);
        if (!res.ok) throw new Error('failed');
        const data = await res.json().catch(() => ({}));
        const matches = data.matches || [];
        matchSelect.innerHTML = matches.length
          ? matches
              .map(
                (m: any) =>
                  `<option value="${esc(m.id)}">${esc(m.home_team)} vs ${esc(m.away_team)} - ${esc(m.kickoff)}</option>`
              )
              .join('')
          : '<option value="">No matches on this date</option>';
      } catch {
        matchSelect.innerHTML = '<option value="">Could not load matches</option>';
      }
    }

    async function generate() {
      const matchId = matchSelect.value;
      const url = sourceUrl.value.trim();
      if (!matchId || !url) {
        genMsg.textContent = 'Pick a match and enter a result page URL.';
        genMsg.className = 'text-sm text-red-400';
        return;
      }
      genMsg.textContent = 'Analysing…';
      genMsg.className = 'text-sm text-[var(--text-2)]';
      const btn = document.getElementById('generate') as HTMLButtonElement;
      btn.disabled = true;
      try {
        const res = await adminFetch('/api/v1/admin/ai/suggest', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ match_id: matchId, source_url: url }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          genMsg.textContent = data.error || 'Could not generate a suggestion.';
          genMsg.className = 'text-sm text-red-400';
          return;
        }
        genMsg.innerHTML = `<span class="text-green-400">Suggestion ${esc(String(data.id || '').slice(0, 8))}: ${esc(data.suggested_home)}-${esc(data.suggested_away)} (HT ${data.suggested_home_ht ?? '?'}-${data.suggested_away_ht ?? '?'}) - confidence ${esc(data.confidence)}.</span>`;
        genMsg.className = 'text-sm';
        void loadList();
      } catch {
        genMsg.textContent = 'Network error.';
        genMsg.className = 'text-sm text-red-400';
      } finally {
        btn.disabled = false;
      }
    }

    async function loadList() {
      const el = document.getElementById('list')!;
      const status = (document.getElementById('filterStatus') as HTMLSelectElement).value;
      el.textContent = 'Loading…';
      try {
        const res = await adminFetch(`/api/v1/admin/ai/suggestions?status=${encodeURIComponent(status)}`);
        if (!res.ok) throw new Error('failed');
        const data = await res.json().catch(() => ({}));
        const items = data.suggestions || [];
        if (!items.length) {
          el.innerHTML = '<div class="text-[var(--text-3)]">No suggestions in this filter.</div>';
          return;
        }
        el.innerHTML = `
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead><tr><th>When</th><th>Match</th><th>Suggested</th><th>Confidence</th><th>Status</th><th>Review</th></tr></thead>
              <tbody>
                ${items.map((s: any) => `
                  <tr data-id="${esc(s.id)}">
                    <td class="text-xs text-[var(--text-3)] whitespace-nowrap">${esc(s.created_at)}</td>
                    <td>
                      <div class="font-medium">${esc(s.home_team)} vs ${esc(s.away_team)}</div>
                      <div class="text-xs text-[var(--text-3)]">${esc(s.match_date)} · ${Object.values(s.market_odds || {}).filter((v: any) => v > 0).map((v: any) => oddsBadge(v)).join(' ') || '—'}</div>
                    </td>
                    <td class="counter">
                      ${s.suggested_home ?? '-'} - ${s.suggested_away ?? '-'}
                      <div class="text-xs text-[var(--text-3)]">HT ${s.suggested_home_ht ?? '?'} - ${s.suggested_away_ht ?? '?'}</div>
                    </td>
                    <td><span class="badge badge-pending">${esc((s.confidence || 'low').toUpperCase())}</span></td>
                    <td><span class="badge ${s.status === 'approved' ? 'badge-win' : s.status === 'rejected' ? 'badge-loss' : s.status === 'failed' ? 'badge-loss' : 'badge-pending'}">${esc(s.status.toUpperCase())}</span></td>
                    <td>
                      ${s.status === 'pending' ? `
                        <div class="admin-actions">
                          <button class="btn btn-secondary text-xs review" data-action="approved" type="button">Approve</button>
                          <button class="btn btn-danger text-xs review" data-action="rejected" type="button">Reject</button>
                        </div>
                        <div class="text-xs text-[var(--text-3)] mt-1">${esc(s.source_url)}</div>
                      ` : `
                        <div class="text-xs text-[var(--text-3)]">by ${esc(s.reviewed_by || '-')} - ${esc(s.reviewed_at || '')}</div>
                        ${s.review_reason ? `<div class="text-xs text-[var(--text-3)]">${esc(s.review_reason)}</div>` : ''}
                      `}
                    </td>
                  </tr>`).join('')}
              </tbody>
            </table>
          </div>`;
      } catch {
        el.textContent = 'Could not load suggestions.';
      }
    }

    document.getElementById('list')!.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('.review') as HTMLButtonElement | null;
      if (!btn) return;
      const row = btn.closest('tr')!;
      const id = row.dataset.id!;
      const action = btn.dataset.action!;
      const reason = action === 'rejected' ? (prompt('Reason for rejection (required):') || '') : '';
      if (action === 'rejected' && !reason.trim()) return;
      btn.disabled = true;
      try {
        const res = await adminFetch(`/api/v1/admin/ai/suggestions/${id}/review`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: action, reason }),
        });
        if (!res.ok) {
          alert('Could not review this suggestion.');
          btn.disabled = false;
          return;
        }
        await loadList();
      } catch {
        alert('Could not review this suggestion. Check your connection.');
      } finally {
        btn.disabled = false;
      }
    });

    void loadMatches();
    void loadList();
  </script>
</AdminLayout>
