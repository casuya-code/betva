---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Betva — Admin Login" hideNav>
  <div class="page-frame page-frame-narrow">
    <div class="flex items-center gap-3 mb-8">
      <img src="/favicon.svg" alt="" class="w-11 h-11 rounded-xl" width="44" height="44" />
      <div>
        <h1 class="text-2xl font-bold leading-tight">Admin sign in</h1>
        <p class="text-sm text-[var(--text-2)]">Credentials come from server environment variables.</p>
      </div>
    </div>

    <form id="form" class="glass p-5 space-y-4">
      <div>
        <label class="text-sm text-[var(--text-2)] mb-1 block" for="username">Username</label>
        <input class="input" id="username" name="username" autocomplete="username" required />
      </div>
      <div>
        <label class="text-sm text-[var(--text-2)] mb-1 block" for="password">Password</label>
        <input class="input" id="password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <div id="codeField" class="hidden">
        <label class="text-sm text-[var(--text-2)] mb-1 block" for="totpCode">Authenticator code</label>
        <input class="input counter" id="totpCode" name="totp_code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="000000" />
        <p class="text-xs text-[var(--text-3)] mt-1">Six-digit code from your authenticator app, or your recovery code.</p>
      </div>
      <button class="btn btn-primary w-full" type="submit">Sign in</button>
      <div id="msg" class="text-center text-sm"></div>
    </form>

    <p class="text-center text-sm text-[var(--text-3)] mt-6">
      <a href="/" class="text-[var(--brand)]">Back to app</a>
    </p>
  </div>

  <script>
    import { API } from '../../lib/admin';
    const form = document.getElementById('form') as HTMLFormElement;
    const msg = document.getElementById('msg')!;
    const codeField = document.getElementById('codeField');
    const codeInput = document.getElementById('totpCode') as HTMLInputElement | null;

    // Show the code field only when the server has an admin TOTP secret.
    fetch(`${API}/api/v1/admin/2fa/status`)
      .then((res) => (res.ok ? res.json() : { required: false }))
      .then((data: { required?: boolean }) => {
        if (data.required) {
          codeField?.classList.remove('hidden');
          if (codeInput) codeInput.required = true;
        }
      })
      .catch(() => {});

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      msg.textContent = 'Signing in...';
      msg.className = 'text-center text-sm text-[var(--text-2)]';
      try {
        const res = await fetch(`${API}/api/v1/admin/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: fd.get('username'),
            password: fd.get('password'),
            totp_code: codeInput?.value || '',
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          msg.textContent = data.error || 'Sign in failed';
          msg.className = 'text-center text-sm text-[var(--danger)]';
          return;
        }
        localStorage.setItem('betva_admin_token', data.token);
        window.location.href = '/admin';
      } catch {
        msg.textContent = 'Could not reach the server.';
        msg.className = 'text-center text-sm text-[var(--danger)]';
      }
    });
  </script>
</Layout>
