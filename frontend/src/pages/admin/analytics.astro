---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Betva Admin — Analytics" active="analytics">
  <div class="space-y-5">
    <div>
      <h1 class="text-2xl font-bold">Analytics</h1>
      <p class="text-sm text-[var(--text-2)]">
        Daily active users (EAT days) and the access-fee planner for the monthly contribution decision.
      </p>
    </div>

    <div class="glass-el p-3 text-sm text-[var(--text-2)]">
      <strong class="text-[var(--text)]">Counting:</strong> each signed-in user once per EAT day. Append-only, never edited.
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="card">
        <div class="text-xs text-[var(--text-3)]">DAU today</div>
        <div class="text-2xl font-bold counter" id="a-today">—</div>
        <div class="text-xs text-[var(--text-3)]">active users</div>
      </div>
      <div class="card">
        <div class="text-xs text-[var(--text-3)]">7-day average</div>
        <div class="text-2xl font-bold counter" id="a-avg">—</div>
        <div class="text-xs text-[var(--text-3)]">per day</div>
      </div>
      <div class="card">
        <div class="text-xs text-[var(--text-3)]">Peak</div>
        <div class="text-2xl font-bold counter" id="a-peak">—</div>
        <div class="text-xs text-[var(--text-3)]">in the window</div>
      </div>
      <div class="card">
        <div class="text-xs text-[var(--text-3)]">Users</div>
        <div class="text-2xl font-bold counter" id="a-total">—</div>
        <div class="text-xs text-[var(--text-3)]"><span id="a-new-today">—</span> new today</div>
      </div>
    </div>

    <!-- DAU chart -->
    <section class="card space-y-3">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <h2 class="font-semibold">Daily active users</h2>
        <span class="text-xs text-[var(--text-3)]" id="a-window">last 30 days</span>
      </div>
      <div id="chart" class="dau-chart" role="img" aria-label="Bar chart of daily active users"></div>
      <div id="chart-labels" class="flex justify-between text-[10px] text-[var(--text-3)]"></div>
    </section>

    <!-- Day table -->
    <section class="card">
      <h2 class="font-semibold mb-3">Day by day</h2>
      <div class="overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr><th>Day</th><th>Active</th><th>New users</th></tr>
          </thead>
          <tbody id="day-rows">
            <tr><td colspan="3"><div class="skeleton h-6 w-full my-1"></div></td></tr>
            <tr><td colspan="3"><div class="skeleton h-6 w-full my-1"></div></td></tr>
            <tr><td colspan="3"><div class="skeleton h-6 w-5/6 my-1"></div></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Access-fee planner -->
    <section class="card space-y-3">
      <h2 class="font-semibold">Access-fee planner</h2>
      <p class="text-sm text-[var(--text-2)]">
        At the DAU target, suggests cost ÷ users rounded up to 500 TZS. The final amount is yours — set
        <code class="text-xs">ACCESS_FEE_DAU_TARGET</code> and <code class="text-xs">MONTHLY_OPERATING_COST_CENTS</code> on the server.
      </p>
      <div id="fee" class="text-sm text-[var(--text-2)]">
        <div class="skeleton h-20 w-full" aria-hidden="true"></div>
      </div>
    </section>
  </div>

  <script>
    import { adminFetch, esc, money, requireAdmin } from '../../lib/admin';

    if (requireAdmin()) load();

    async function load() {
      try {
        const res = await adminFetch('/api/v1/admin/analytics?days=30');
        if (!res.ok) {
          showAnalyticsError();
          return;
        }
        const d = await res.json().catch(() => ({}));
        setText('a-today', String(d.dau_today ?? 0));
        setText('a-avg', String(d.dau_avg_7d ?? 0));
        setText('a-peak', String(d.dau_peak ?? 0));
        setText('a-total', String(d.users_total ?? 0));
        setText('a-new-today', String(d.users_new_today ?? 0));

        renderChart(d.days || []);
        renderTable(d.days || []);
        renderFee(d.fee_plan || {});
      } catch {
        showAnalyticsError();
      }
    }

    function showAnalyticsError() {
      const rows = document.getElementById('day-rows')!;
      const fee = document.getElementById('fee')!;
      rows.innerHTML = '<tr><td colspan="3"><div class="text-center text-[var(--text-2)] py-2 space-y-2"><p>Could not load analytics.</p><button type="button" class="btn btn-secondary text-sm" id="retryAnalytics">Retry</button></div></td></tr>';
      fee.innerHTML = '<div class="text-center text-[var(--text-2)] space-y-2"><p>Could not load planner data.</p></div>';
      document.getElementById('retryAnalytics')?.addEventListener('click', () => {
        rows.innerHTML = '<tr><td colspan="3"><div class="skeleton h-6 w-full my-1"></div></td></tr><tr><td colspan="3"><div class="skeleton h-6 w-full my-1"></div></td></tr><tr><td colspan="3"><div class="skeleton h-6 w-5/6 my-1"></div></td></tr>';
        fee.innerHTML = '<div class="skeleton h-20 w-full" aria-hidden="true"></div>';
        void load();
      }, { once: true });
    }

    function renderChart(days: any[]) {
      const el = document.getElementById('chart')!;
      const max = Math.max(1, ...days.map((x: any) => x.dau));
      el.innerHTML = days
        .map((x: any) => {
          const h = Math.max(2, Math.round((x.dau / max) * 100));
          const isToday = x.dau > 0 ? '' : ' dau-zero';
          return `<div class="dau-bar${isToday}" style="height:${h}%" title="${x.day}: ${x.dau} active, ${x.new_users} new"></div>`;
        })
        .join('');
      const labels = document.getElementById('chart-labels')!;
      const first = days[0]?.day || '';
      const last = days[days.length - 1]?.day || '';
      labels.innerHTML = `<span>${esc(first)}</span><span>${esc(last)}</span>`;
    }

    function renderRowsChunked<T>(tbody: HTMLTableSectionElement, items: T[], render: (item: T) => string, size = 20) {
      let i = 0;
      const step = () => {
        const end = Math.min(i + size, items.length);
        let html = '';
        for (; i < end; i++) html += render(items[i]);
        if (html) tbody.insertAdjacentHTML('beforeend', html);
        if (i < items.length) requestAnimationFrame(step);
      };
      step();
    }

    function renderTable(days: any[]) {
      const el = document.getElementById('day-rows')!;
      const rows = [...days].reverse();
      if (!rows.length) {
        el.innerHTML = '<tr><td colspan="3">No data yet.</td></tr>';
        return;
      }
      el.innerHTML = '';
      renderRowsChunked(el as HTMLTableSectionElement, rows, (x: any) => `
        <tr>
          <td>${esc(x.day)}</td>
          <td>${x.dau}</td>
          <td>${x.new_users}</td>
        </tr>`);
    }

    function renderFee(f: any) {
      const el = document.getElementById('fee')!;
      if (!f.configured) {
        el.innerHTML =
          'Not configured yet — set <code>ACCESS_FEE_DAU_TARGET</code> and <code>MONTHLY_OPERATING_COST_CENTS</code> on the server, then reopen this page.';
        return;
      }
      const reached = f.reached
        ? '<span class="badge badge-win">Target reached</span>'
        : '<span class="badge badge-pending">Below target</span>';
      const fee = f.suggested_fee_cents
        ? `${money(f.suggested_fee_cents)} TZS / user / month`
        : '—';
      el.innerHTML = `
        <div class="flex items-center gap-3 flex-wrap mb-2">
          ${reached}
          <span class="text-xs text-[var(--text-3)]">target ${f.target_dau} DAU · cost ${money(f.monthly_cost_cents)} TZS / month</span>
        </div>
        <div class="grid grid-cols-3 gap-2 text-center">
          <div><div class="text-xl font-bold counter">${f.target_dau}</div><div class="text-[11px] text-[var(--text-3)]">Target DAU</div></div>
          <div><div class="text-xl font-bold counter">${money(f.monthly_cost_cents)}</div><div class="text-[11px] text-[var(--text-3)]">Monthly cost (TZS)</div></div>
          <div><div class="text-xl font-bold counter">${fee.split(' ')[0]}</div><div class="text-[11px] text-[var(--text-3)]">Suggested fee / user / month</div></div>
        </div>`;
    }

    function setText(id: string, v: string) {
      const el = document.getElementById(id);
      if (el) el.textContent = v;
    }
  </script>

  <style>
    .dau-chart {
      display: flex;
      align-items: flex-end;
      gap: 2px;
      height: 120px;
      padding: 8px 0;
      border-bottom: 1px solid var(--border);
    }
    .dau-bar {
      flex: 1;
      min-width: 3px;
      background: linear-gradient(180deg, var(--brand), var(--brand-2));
      border-radius: 3px 3px 0 0;
    }
    .dau-bar.dau-zero {
      background: var(--border);
    }
  </style>
</AdminLayout>
