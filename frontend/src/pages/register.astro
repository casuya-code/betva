---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Betva — Register" description="Create a Betva account with your phone number and a nickname.">
  <div class="page-frame page-frame-narrow">
    <h1 class="text-3xl font-bold mb-2">Create account</h1>
    <p class="text-[var(--text-2)] mb-6">Register with your phone number.</p>

    <!-- KYC notice -->
    <div class="glass p-4 mb-6 border-l-4 border-l-[var(--warning)]">
      <p class="text-sm font-semibold mb-1">Official name notice</p>
      <p class="text-sm text-[var(--text-2)]">
        Enter the <strong>official name registered to this phone number</strong>.
        We use it only to confirm you truly own this account.
        It is <strong>visible to administrators only</strong> and never shown publicly.
        If it does not match the registered owner, you will receive a <strong>7-day notice</strong> to correct it or appeal.
      </p>
    </div>

    <form id="regForm" class="space-y-4">
      <div>
        <label class="text-sm text-[var(--text-2)] mb-1 block" for="regNick">Nickname</label>
        <input class="input" id="regNick" name="nickname" required />
      </div>
      <div>
        <label class="text-sm text-[var(--text-2)] mb-1 block" for="regPhone">Phone number</label>
        <input class="input" id="regPhone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="0712 345 678" required />
      </div>
      <div>
        <label class="text-sm text-[var(--text-2)] mb-1 block" for="regOfficial">Official name (phone owner)</label>
        <input class="input" id="regOfficial" name="official_name" autocomplete="name" required />
      </div>
      <div>
        <label class="text-sm text-[var(--text-2)] mb-1 block" for="regPassword">Password</label>
        <input class="input" id="regPassword" name="password" type="password" autocomplete="new-password" minlength="6" required />
      </div>
      <label class="flex items-start gap-2 text-sm text-[var(--text-2)]">
        <input type="checkbox" name="accepted_terms" class="mt-1" required />
        <span>I have read and accept the <a href="/terms" class="text-[var(--brand)] underline">Terms of Service</a>, including the single official payment number rule, and confirm the official name above is registered to this phone number.</span>
      </label>
      <button class="btn btn-primary w-full" type="submit">Register</button>
    </form>

    <p class="text-center text-sm text-[var(--text-2)] mt-6">
      Have an account? <a href="/login" class="text-[var(--brand)]">Login</a>
    </p>
    <div id="msg" class="mt-4 text-center text-sm"></div>
  </div>

  <script>
    import { API } from '../lib/api';
    const form = document.getElementById('regForm') as HTMLFormElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('msg')!;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const fd = new FormData(form);
      const payload = {
        nickname: fd.get('nickname'),
        phone: fd.get('phone'),
        official_name: fd.get('official_name'),
        password: fd.get('password'),
        accepted_terms: fd.get('accepted_terms') === 'on',
      };
      msg.textContent = 'Creating account...';
      msg.className = 'mt-4 text-center text-sm text-[var(--text-2)]';
      if (btn) btn.disabled = true;
      try {
        const res = await fetch(`${API}/api/v1/auth/register`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          localStorage.setItem('betva_token', data.token);
          localStorage.setItem('betva_session_start', String(Date.now()));
          msg.textContent = 'Account created. Redirecting...';
          msg.className = 'mt-4 text-center text-sm text-green-400';
          window.location.href = '/';
        } else {
          msg.textContent = data.error || 'Registration failed';
          msg.className = 'mt-4 text-center text-sm text-red-400';
        }
      } catch {
        msg.textContent = 'Could not reach the server.';
        msg.className = 'mt-4 text-center text-sm text-red-400';
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  </script>
</Layout>
