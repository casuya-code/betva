---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Betva — Community" active="community">
  <div class="px-4 pt-4 space-y-4">
    <h1 class="text-2xl font-bold">Community</h1>
    <div class="glass p-3 flex gap-2">
      <input class="input" placeholder="Share something..." />
      <button class="btn btn-primary">Post</button>
    </div>
    <div id="feed" class="space-y-3">
      <div class="card"><div class="skeleton h-24"></div></div>
      <div class="card"><div class="skeleton h-24"></div></div>
    </div>
  </div>
</Layout>
